<%
  // appearance comes from the server (settings.appearance). Everything below is
  // defensive so the site still renders if a setting is missing.
  var headerAppearance = (typeof appearance === 'object' && appearance) ? appearance : {};
  var headerConfig = (headerAppearance.header && typeof headerAppearance.header === 'object') ? headerAppearance.header : {};
  var headerLayout = headerConfig.layout === 'logo-left' ? 'logo-left' : 'nav-left';
  var headerLogo = (typeof logoUrl !== 'undefined' && logoUrl) ? String(logoUrl) : '';
  var headerActive = (typeof active !== 'undefined' && active) ? String(active) : '';
  // V2 site structure: About is the root page, the work grid lives at /portfolio.
  var headerLinks = [
    { key: 'about', label: 'About', href: '/' },
    { key: 'portfolio', label: 'Portfolio', href: '/portfolio' },
    { key: 'contact', label: 'Contact', href: '/contact' }
  ];
%>
<header data-layout="<%= headerLayout %>">
  <nav id="main-nav">
    <ul>
      <% headerLinks.forEach(function (link) { %>
        <li><a href="<%= link.href %>" class="<%= headerActive === link.key ? 'active' : '' %>"<% if (headerActive === link.key) { %> aria-current="page"<% } %>><%= link.label %></a></li>
      <% }); %>
    </ul>
  </nav>
  <a href="/" class="logo" aria-label="Jon Messier home">
    <% if (headerLogo) { %><img src="<%= headerLogo %>" alt="JM Logo"><% } else { %><span class="logo-text">JM</span><% } %>
  </a>
  <button class="menu-toggle" aria-label="Menu" onclick="document.getElementById('main-nav').classList.toggle('active')">☰</button>
</header>
