<%
  // Footer settings come from content.footer (fallback to the site's old defaults).
  var footerContent = (typeof content === 'object' && content) ? content : {};
  var footerSeo = (footerContent.seo && typeof footerContent.seo === 'object') ? footerContent.seo : {};
  var footerConfig = (footerContent.footer && typeof footerContent.footer === 'object') ? footerContent.footer : {};
  var footerSiteName = (footerSeo.siteName && String(footerSeo.siteName).trim()) ? String(footerSeo.siteName).trim() : 'Jon Messier';
  var footerYear = (typeof currentYear !== 'undefined' && currentYear != null) ? currentYear : new Date().getFullYear();
  var footerShow = footerConfig.show !== false;
  var footerText = (footerConfig.text && String(footerConfig.text).trim()) ? String(footerConfig.text).trim() : '';
  var footerCopy = footerText || ('© ' + footerYear + ' ' + footerSiteName);
  var footerLogo = (typeof logoUrl !== 'undefined' && logoUrl) ? String(logoUrl) : '';
  var footerLogoTinted = (typeof logoIsTinted !== 'undefined') ? !!logoIsTinted : false;
  // The server already validates these URLs; re-check http(s) so a bad row can never become a link.
  var footerSocials = Array.isArray(footerConfig.social) ? footerConfig.social.filter(function (item) {
    return item && item.label && typeof item.url === 'string' && /^https?:\/\//i.test(item.url);
  }).slice(0, 4) : [];
%>
<%# The footer stays in the DOM (just hidden) when switched off, so the admin's live preview can toggle it on. %>
<footer class="site-footer"<% if (!footerShow) { %> hidden<% } %>>
  <div class="footer-inner">
    <% if (footerLogo) { %><img class="footer-logo<%= footerLogoTinted ? ' logo-tinted' : '' %>" src="<%= footerLogo %>" alt="<%= footerSiteName %>" loading="lazy"><% } %>
    <%# Kept in the DOM even when empty so the admin's live preview can add social links. %>
    <ul class="footer-social" data-footer-social>
      <% footerSocials.forEach(function (link) { %>
        <li><a href="<%= link.url %>" target="_blank" rel="noopener noreferrer"><%= link.label %></a></li>
      <% }); %>
    </ul>
    <p class="footer-copy" data-footer-text><%= footerCopy %></p>
  </div>
</footer>
