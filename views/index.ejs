<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Jon Messier | Portfolio</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body id="top">
  <header>
    <nav id="main-nav">
      <ul>
        <li><a href="/" class="active">Portfolio</a></li>
        <li><a href="#">Contact</a></li>
      </ul>
    </nav>
    <div class="logo">
      <% if (logoUrl) { %><img src="<%= logoUrl %>" alt="JM Logo" style="filter: brightness(0) invert(1);"><% } else { %><span class="logo-text">JM</span><% } %>
    </div>
    <button class="menu-toggle" onclick="document.getElementById('main-nav').classList.toggle('active')">☰</button>
  </header>
  <main>
    <div class="grid">
      <% projects.forEach(function(project) { %>
        <a href="/project/<%= project.id %>" class="project-card">
          <img src="<%= project.cover_image %>" alt="<%= project.title %>" class="thumb" oncontextmenu="return false;">
          <h2><%= project.title %></h2>
        </a>
      <% }); %>
    </div>
  </main>
</body>
</html>