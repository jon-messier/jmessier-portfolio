<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Jon Messier | Portfolio</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/theme.css?bg=<%= encodeURIComponent(bg) %>">
</head>
<body id="top">
  <%- include('partials/header', { logoUrl, active }) %>
  <main>
    <div class="grid">
      <% projects.forEach(function(project) { %>
        <a href="/project/<%= project.slug %>" class="project-card">
          <img src="<%= project.cover_image %>" alt="<%= project.title %>" class="thumb" oncontextmenu="return false;">
          <h2><%= project.title %></h2>
        </a>
      <% }); %>
    </div>
  </main>
</body>
</html>