<%
  // Portfolio grid page (served at /portfolio in V2). Locals come from server.js per
  // V2-CONTRACT.md §4; everything is normalised so a missing local never breaks the page.
  var appearanceData = (typeof appearance === 'object' && appearance) ? appearance : {};
  var contentData = (typeof content === 'object' && content) ? content : {};
  var seoData = (contentData.seo && typeof contentData.seo === 'object') ? contentData.seo : {};
  var siteName = (seoData.siteName && String(seoData.siteName).trim()) ? String(seoData.siteName).trim() : 'Jon Messier';
  // Avoid titles like "Portfolio | Jon Messier Portfolio" when the site name already ends in Portfolio.
  var siteNameShort = siteName.replace(/\s+Portfolio\s*$/i, '').trim() || siteName;
  var pageTitle = 'Portfolio | ' + siteNameShort;
  var pageDescription = (seoData.description && String(seoData.description).trim()) ? String(seoData.description).trim().replace(/\s+/g, ' ') : '';
  var ogImage = (seoData.ogImage && /^https?:\/\//i.test(String(seoData.ogImage))) ? String(seoData.ogImage) : '';
  var siteCss = (typeof siteCssVersion !== 'undefined' && siteCssVersion != null) ? String(siteCssVersion) : '';
  var pageYear = (typeof currentYear !== 'undefined' && currentYear != null) ? currentYear : new Date().getFullYear();
  var logoSrc = (typeof logoUrl !== 'undefined' && logoUrl) ? String(logoUrl) : '';
  var activePage = (typeof active !== 'undefined' && active) ? String(active) : 'portfolio';
  var bgColor = (typeof bg !== 'undefined' && bg) ? String(bg) : '#181818';
  // Server-supplied, already-tinted favicon (V2 §4). Never rebuilt from content.seo.favicon here.
  var faviconHref = (typeof faviconUrl !== 'undefined' && faviconUrl && /^(https?:\/\/|\/)/i.test(String(faviconUrl))) ? String(faviconUrl) : '';
  var projectList = (typeof projects !== 'undefined' && Array.isArray(projects)) ? projects : [];
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <% if (pageDescription) { %>
  <meta name="description" content="<%= pageDescription %>">
  <% } %>
  <meta property="og:title" content="<%= pageTitle %>">
  <% if (pageDescription) { %>
  <meta property="og:description" content="<%= pageDescription %>">
  <% } %>
  <% if (ogImage) { %>
  <meta property="og:image" content="<%= ogImage %>">
  <% } %>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= siteName %>">
  <% if (faviconHref) { %>
  <link rel="icon" href="<%= faviconHref %>">
  <% } %>
  <link rel="stylesheet" href="/site.css?v=<%= siteCss %>">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/theme.css?bg=<%= encodeURIComponent(bgColor) %>">
</head>
<body id="top">
  <%- include('partials/header', { logoUrl: logoSrc, active: activePage, appearance: appearanceData }) %>
  <main class="home-page">
    <div class="grid">
      <% projectList.forEach(function(project) { %>
        <a href="/project/<%= project.slug %>" class="project-card">
          <img src="<%= project.cover_image %>" alt="<%= project.title %>" class="thumb" oncontextmenu="return false;">
          <h2><%= project.title %></h2>
        </a>
      <% }); %>
    </div>
  </main>
  <%- include('partials/footer', { content: contentData, currentYear: pageYear, logoUrl: logoSrc }) %>
</body>
</html>
