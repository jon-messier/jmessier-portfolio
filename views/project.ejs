<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= project.title %> | Jon Messier</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body id="top">
  <header>
    <nav id="main-nav">
      <ul><li><a href="/">← Back to Portfolio</a></li></ul>
    </nav>
    <div class="logo">
      <% if (logoUrl) { %><img src="<%= logoUrl %>" alt="JM Logo" style="filter: brightness(0) invert(1);"><% } else { %><span class="logo-text">JM</span><% } %>
    </div>
    <button class="menu-toggle" onclick="document.getElementById('main-nav').classList.toggle('active')">☰</button>
  </header>
  <main>
    <div class="project-header">
      <h1><%= project.title %></h1>
      <% if (project.description) { %><p style="color: #aaa; max-width: 600px; margin: 1rem auto 0;"><%= project.description %></p><% } %>
    </div>
    
    <div class="project-blocks">
      <% if (Array.isArray(project.blocks) && project.blocks.length > 0) { %>
        <% project.blocks.forEach(function(block) { %>
          <% if (block.type === 'single') { %>
            <div class="block-single"><img src="<%= block.url %>" onclick="openLightbox(this.src)" oncontextmenu="return false;"></div>
          <% } else if (block.type === 'grid') { %>
            <div class="block-grid" style="gap: <%= block.gap || 1.5 %>rem;">
              <% block.images.forEach(function(img) { %><img src="<%= img %>" onclick="openLightbox(this.src)" oncontextmenu="return false;"><% }); %>
            </div>
          <% } else if (block.type === 'embed') { %>
            <div class="block-embed"><%- block.code %></div>
          <% } %>
        <% }); %>
      <% } else { %>
        <div style="text-align: center; color: #888; margin-top: 2rem; padding: 2rem; border: 1px dashed #444;">
          <p>No images have been added to this project yet.</p>
        </div>
      <% } %>
    </div>
    
    <div style="margin-top: 5rem; padding: 1rem; background: #222; border: 1px solid #444; font-family: monospace; font-size: 0.8rem; overflow-x: auto;">
      <h3 style="color:#4361ee; margin-bottom: 0.5rem;">Database Debug Info:</h3>
      <pre><%= JSON.stringify(project.blocks, null, 2) %></pre>
    </div>

    <a href="#top" class="back-to-top">↑ Back to Top</a>
    
    <% if (otherProjects && otherProjects.length > 0) { %>
      <div class="carousel-section">
        <h2 class="carousel-title">More Projects</h2>
        <div class="carousel">
          <% otherProjects.forEach(function(op) { %>
            <a href="/project/<%= op.id %>" class="carousel-item">
              <img src="<%= op.cover_image %>" alt="<%= op.title %>" oncontextmenu="return false;">
              <h3><%= op.title %></h3>
            </a>
          <% }); %>
        </div>
      </div>
    <% } %>
  </main>
  <div id="lightbox" class="lightbox" onclick="closeLightbox()">
    <span class="lightbox-close">&times;</span>
    <img id="lightbox-img" src="" oncontextmenu="return false;">
  </div>
  <script src="/script.js"></script>
</body>
</html>