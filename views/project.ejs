<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= project.title %> | Jon Messier</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/theme.css?bg=<%= encodeURIComponent(bg) %>">
</head>
<body id="top">
  <%- include('partials/header', { logoUrl, active }) %>
  <main class="project-page">
    <% if (isPreview) { %>
      <div class="preview-banner">This project is hidden. Only you can see it because you're logged in.</div>
    <% } %>
    <div class="project-header">
      <h1><%= project.title %></h1>
      <% if (project.description) { %><p class="project-description"><%= project.description %></p><% } %>
    </div>

    <div class="project-blocks" data-width="<%= project.content_width %>" data-gap="<%= project.block_gap %>">
      <% if (project.blocks.length > 0) { %>
        <% project.blocks.forEach(function(block) { %>
          <% if (block.type === 'single') { %>
            <div class="block-single"><img src="<%= block.url %>" onclick="openLightbox(this.src)" oncontextmenu="return false;"></div>
          <% } else if (block.type === 'grid') { %>
            <div class="block-grid" data-cols="<%= block.cols %>" data-gap="<%= block.gap %>">
              <% block.images.forEach(function(img) { if (img) { %><img src="<%= img %>" onclick="openLightbox(this.src)" oncontextmenu="return false;"><% } }); %>
            </div>
          <% } else if (block.type === 'embed') { %>
            <div class="block-embed"><%- block.code %></div>
          <% } %>
        <% }); %>
      <% } else { %>
        <div class="project-empty"><p>No images have been added to this project yet.</p></div>
      <% } %>
    </div>

    <a href="#top" class="back-to-top">↑ Back to Top</a>

    <% if (otherProjects && otherProjects.length > 0) { %>
      <div class="carousel-section">
        <h2 class="carousel-title">More Projects</h2>
        <div class="carousel">
          <% otherProjects.forEach(function(op) { %>
            <a href="/project/<%= op.slug %>" class="carousel-item">
              <img src="<%= op.cover_image %>" alt="<%= op.title %>" oncontextmenu="return false;">
              <h3><%= op.title %></h3>
            </a>
          <% }); %>
        </div>
      </div>
    <% } %>
  </main>
  <div id="lightbox" class="lightbox" onclick="closeLightbox()">
    <span class="lightbox-close">&times;</span>
    <img id="lightbox-img" src="" oncontextmenu="return false;">
  </div>
  <script src="/script.js"></script>
</body>
</html>