  </div>

  <div class="toast-stack" id="toasts" aria-live="polite"></div>

  <script id="admin-data" type="application/json"><%- JSON.stringify({ projects: projects, messages: messages, appearance: locals.appearance || null, content: locals.content || null, securityStatus: locals.securityStatus || null, branding: locals.branding || null, logoUrl: locals.logoUrl || '', config: locals.config || { siteBg: locals.siteBg || locals.bg || '#181818', defaultBg: locals.defaultBg || '#181818', pageWidths: locals.pageWidths, blockGaps: locals.blockGaps } }).replace(/</g, '\\u003c') %></script>
  <script>
    const DATA = JSON.parse(document.getElementById('admin-data').textContent);
    const CONFIG = Object.assign({ siteBg: '#181818', defaultBg: '#181818', pageWidths: [640, 860, 1100, 1400], blockGaps: [0, 1, 2, 4] }, DATA.config || {});
    const WIDTH_LABELS = { 640: 'Narrow (640px)', 860: 'Medium (860px)', 1100: 'Standard (1100px)', 1400: 'Wide (1400px)' };
    const GAP_LABELS = { 0: 'None', 1: 'Tight', 2: 'Normal', 4: 'Wide' };

    // ======================================================================
    // Small helpers
    // ======================================================================
    function el(tag, attrs, ...kids) {
      const node = document.createElement(tag);
      for (const [k, v] of Object.entries(attrs || {})) {
        if (k === 'class') node.className = v;
        else if (k === 'text') node.textContent = v;
        else if (k.startsWith('on')) node.addEventListener(k.slice(2), v);
        else if (v === true) node.setAttribute(k, '');
        else if (v !== false && v != null) node.setAttribute(k, v);
      }
      kids.forEach(kid => kid && node.append(kid));
      return node;
    }
    const mini = (text, title, onclick, opts) =>
      el('button', Object.assign({ type: 'button', class: 'mini', text, title, onclick }, opts || {}));
    const clone = (x) => JSON.parse(JSON.stringify(x));
    const fmtSize = (b) => (b >= 1048576 ? (b / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(b / 1024)) + ' KB');
    function setMsg(node, msg, kind) { node.className = 'status-msg' + (kind ? ' ' + kind : ''); node.textContent = msg || ''; }

    // POST JSON to the server; turns every failure into a readable message
    async function api(url, body) {
      let res;
      try {
        res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin', body: JSON.stringify(body || {}) });
      } catch (e) {
        throw new Error("Couldn't reach your server. Check your internet connection and try again.");
      }
      let data = {};
      try { data = await res.json(); } catch (e) {}
      if (!res.ok) throw new Error(data.error || ('The server returned error ' + res.status + '. Please try again.'));
      return data;
    }

    // Toast notifications (top-right). Click one to dismiss it; they also fade out on their own.
    const toastStack = document.getElementById('toasts');
    function dismissToast(node) {
      if (!node || !node.isConnected || node.classList.contains('leaving')) return;
      node.classList.add('leaving');
      setTimeout(() => node.remove(), 200);
    }
    function toast(message, kind, ms) {
      if (!toastStack) return;
      const node = el('div', { class: 'toast' + (kind ? ' ' + kind : ''), role: 'status', text: message });
      node.addEventListener('click', () => dismissToast(node));
      toastStack.append(node);
      setTimeout(() => dismissToast(node), ms || (kind === 'err' ? 7000 : 4000));
    }

    // ======================================================================
    // Reusable Photoshop-style HSB color picker
    // Attaches to a native <input type="color">: the native control is hidden and
    // replaced by a swatch + hex label. Clicking the swatch opens a popover with an
    // SV square, a vertical hue slider, new/current swatches, H/S/B fields and a
    // pasteable hex field. While open the value updates live: input.value is set and
    // a bubbling "input" event is dispatched, so the existing draft/background
    // handlers fire. Cancel restores the value from when the popover opened.
    // ======================================================================
    const CP_HEX = /^#[0-9a-fA-F]{6}$/;
    const cpClamp = (n, min, max) => Math.min(max, Math.max(min, n));
    const cpNumber = (value, fallback) => { const n = Number(value); return Number.isFinite(n) ? n : fallback; };
    function cpHexToRgb(value) {
      const hex = typeof value === 'string' ? value.trim() : '';
      if (/^#[0-9a-fA-F]{3}$/.test(hex)) return [1, 2, 3].map(i => parseInt(hex[i] + hex[i], 16));
      if (!CP_HEX.test(hex)) return null;
      return [1, 3, 5].map(i => parseInt(hex.slice(i, i + 2), 16));
    }
    function cpRgbToHex(rgb) {
      return '#' + rgb.map(v => cpClamp(Math.round(v), 0, 255).toString(16).padStart(2, '0')).join('');
    }
    function cpRgbToHsb(rgb) {
      const [r, g, b] = rgb.map(v => v / 255);
      const max = Math.max(r, g, b), min = Math.min(r, g, b), delta = max - min;
      let h = 0;
      if (delta) {
        if (max === r) h = ((g - b) / delta) % 6;
        else if (max === g) h = (b - r) / delta + 2;
        else h = (r - g) / delta + 4;
        h *= 60;
        if (h < 0) h += 360;
      }
      return { h, s: max ? delta / max : 0, v: max };
    }
    function cpHsbToRgb(h, s, v) {
      const hue = ((h % 360) + 360) % 360;
      const c = v * s, x = c * (1 - Math.abs((hue / 60) % 2 - 1)), m = v - c;
      let rgb;
      if (hue < 60) rgb = [c, x, 0];
      else if (hue < 120) rgb = [x, c, 0];
      else if (hue < 180) rgb = [0, c, x];
      else if (hue < 240) rgb = [0, x, c];
      else if (hue < 300) rgb = [x, 0, c];
      else rgb = [c, 0, x];
      return rgb.map(ch => (ch + m) * 255);
    }
    const cpHsbToHex = (h, s, v) => cpRgbToHex(cpHsbToRgb(h, s, v));
    function cpNormalizeHex(value) {
      const rgb = cpHexToRgb(value);
      return rgb ? cpRgbToHex(rgb) : '';
    }

    let cpOpen = null;   // the currently open picker session
    function cpCloseActive(restore) {
      if (!cpOpen) return;
      const session = cpOpen;
      cpOpen = null;
      session.cleanup();
      if (restore) session.restore();
    }
    function cpPosition(pop, anchor) {
      const rect = anchor.getBoundingClientRect();
      const margin = 8;
      const width = pop.offsetWidth || 258;
      const height = pop.offsetHeight || 360;
      let left = rect.left;
      if (left + width > window.innerWidth - margin) left = window.innerWidth - width - margin;
      let top = rect.bottom + 6;
      if (top + height > window.innerHeight - margin) top = rect.top - height - 6;
      pop.style.left = Math.max(margin, left) + 'px';
      pop.style.top = Math.max(margin, top) + 'px';
    }

    // opts: { title, fallback } — fallback is used when the input has no valid hex yet.
    function attachColorPicker(input, opts) {
      const options = opts || {};
      const fallbackColor = cpNormalizeHex(options.fallback) || '#ff5a36';
      const valueDescriptor = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value');
      const readValue = () => cpNormalizeHex(valueDescriptor.get.call(input)) || fallbackColor;

      input.classList.add('cp-native');
      const swatch = el('button', { type: 'button', class: 'cp-swatch', title: options.title || 'Pick a color', 'aria-label': options.title || 'Pick a color' });
      const hexLabel = el('code', { class: 'cp-hexlabel' });
      const attach = el('span', { class: 'cp-attach' }, swatch, hexLabel);
      input.insertAdjacentElement('afterend', attach);

      // Keep the visible swatch in step with programmatic .value / .disabled changes.
      function paint() {
        const color = readValue();
        swatch.style.background = color;
        swatch.disabled = !!input.disabled;
        swatch.classList.toggle('cp-disabled', !!input.disabled);
        hexLabel.textContent = color;
        if (cpOpen && cpOpen.input === input) cpOpen.load(color);
      }
      Object.defineProperty(input, 'value', {
        configurable: true,
        enumerable: true,
        get() { return valueDescriptor.get.call(input); },
        set(value) { valueDescriptor.set.call(input, value); paint(); }
      });
      const observer = new MutationObserver(paint);   // e.g. the "Site default" checkbox toggles disabled
      observer.observe(input, { attributes: true, attributeFilter: ['disabled'] });
      input.addEventListener('input', paint);
      swatch.addEventListener('click', () => open());

      function open() {
        if (input.disabled || cpOpen) return;
        const original = readValue();
        let state = cpRgbToHsb(cpHexToRgb(original));

        const svHandle = el('div', { class: 'cp-sv-handle' });
        const sv = el('div', { class: 'cp-sv' }, el('div', { class: 'cp-sv-white' }), el('div', { class: 'cp-sv-black' }), svHandle);
        const hueHandle = el('div', { class: 'cp-hue-handle' });
        const hue = el('div', { class: 'cp-hue' }, hueHandle);
        const newBox = el('div', { class: 'cp-swatch-color cp-new', title: 'New color (live preview)' });
        const currentBox = el('div', { class: 'cp-swatch-color cp-current', title: 'Click to go back to the original color' });
        currentBox.style.background = original;
        const newWrap = el('div', { class: 'cp-swatch-box' }, el('span', { text: 'New' }), newBox);
        const currentWrap = el('div', { class: 'cp-swatch-box' }, el('span', { text: 'Current' }), currentBox);

        const hInput = el('input', { type: 'number', min: '0', max: '360', step: '1', 'aria-label': 'Hue' });
        const sInput = el('input', { type: 'number', min: '0', max: '100', step: '1', 'aria-label': 'Saturation' });
        const bInput = el('input', { type: 'number', min: '0', max: '100', step: '1', 'aria-label': 'Brightness' });
        const hexInput = el('input', { type: 'text', spellcheck: 'false', maxlength: '7', placeholder: '#rrggbb', 'aria-label': 'Hex color' });
        const titleHex = el('code');
        const fields = el('div', { class: 'cp-fields' },
          el('div', {}, el('label', { text: 'H' }), hInput),
          el('div', {}, el('label', { text: 'S' }), sInput),
          el('div', {}, el('label', { text: 'B' }), bInput));
        const hexRow = el('div', { class: 'cp-hex-row' }, el('label', { text: 'Hex' }), hexInput);
        const cancelBtn = mini('Cancel', 'Close without keeping this color', () => cpCloseActive(true));
        const okBtn = mini('OK', 'Keep this color', () => cpCloseActive(false), { class: 'mini ok' });
        const actions = el('div', { class: 'cp-actions' }, cancelBtn, okBtn);
        const pop = el('div', { class: 'cp-pop', role: 'dialog', 'aria-label': options.title || 'Color picker', tabindex: '-1' },
          el('div', { class: 'cp-pop-head' }, el('span', { text: options.title || 'Pick a color' }), titleHex),
          el('div', { class: 'cp-body' }, sv, hue),
          el('div', { class: 'cp-swatches' }, newWrap, currentWrap),
          fields, hexRow, actions);

        const currentHex = () => cpHsbToHex(state.h, state.s, state.v);
        function render() {
          const hex = currentHex();
          sv.style.background = 'hsl(' + Math.round(state.h) + ', 100%, 50%)';
          svHandle.style.left = (state.s * 100) + '%';
          svHandle.style.top = ((1 - state.v) * 100) + '%';
          hueHandle.style.top = (state.h / 360 * 100) + '%';
          hInput.value = String(Math.round(state.h));
          sInput.value = String(Math.round(state.s * 100));
          bInput.value = String(Math.round(state.v * 100));
          if (document.activeElement !== hexInput) hexInput.value = hex;
          titleHex.textContent = hex;
          newBox.style.background = hex;
          return hex;
        }
        // Push the live value into the native input and tell the rest of the admin about it.
        function live(hex) {
          if (valueDescriptor.get.call(input) !== hex) {
            valueDescriptor.set.call(input, hex);
            paint();
          }
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
        function load(hex) {
          const rgb = cpHexToRgb(hex);
          if (!rgb) return;
          const hsb = cpRgbToHsb(rgb);
          if (cpHsbToHex(hsb.h, hsb.s, hsb.v) === currentHex()) return;
          state = hsb;
          render();
        }

        let svDragging = false;
        function pickSv(event) {
          const rect = sv.getBoundingClientRect();
          state.s = cpClamp((event.clientX - rect.left) / rect.width, 0, 1);
          state.v = 1 - cpClamp((event.clientY - rect.top) / rect.height, 0, 1);
          live(render());
        }
        sv.addEventListener('pointerdown', e => { e.preventDefault(); svDragging = true; sv.setPointerCapture(e.pointerId); pickSv(e); });
        sv.addEventListener('pointermove', e => { if (svDragging) pickSv(e); });
        sv.addEventListener('pointerup', () => { svDragging = false; });
        sv.addEventListener('pointercancel', () => { svDragging = false; });

        let hueDragging = false;
        function pickHue(event) {
          const rect = hue.getBoundingClientRect();
          state.h = cpClamp((event.clientY - rect.top) / rect.height, 0, 1) * 360;
          live(render());
        }
        hue.addEventListener('pointerdown', e => { e.preventDefault(); hueDragging = true; hue.setPointerCapture(e.pointerId); pickHue(e); });
        hue.addEventListener('pointermove', e => { if (hueDragging) pickHue(e); });
        hue.addEventListener('pointerup', () => { hueDragging = false; });
        hue.addEventListener('pointercancel', () => { hueDragging = false; });

        function applyFields() {
          state.h = cpClamp(cpNumber(hInput.value, state.h), 0, 360);
          state.s = cpClamp(cpNumber(sInput.value, state.s * 100), 0, 100) / 100;
          state.v = cpClamp(cpNumber(bInput.value, state.v * 100), 0, 100) / 100;
          live(render());
        }
        hInput.addEventListener('input', applyFields);
        sInput.addEventListener('input', applyFields);
        bInput.addEventListener('input', applyFields);
        hexInput.addEventListener('input', () => {
          const raw = hexInput.value.trim();
          const hex = cpNormalizeHex(/^#/.test(raw) ? raw : '#' + raw);
          if (!hex) return;
          state = cpRgbToHsb(cpHexToRgb(hex));
          live(render());
        });
        hexInput.addEventListener('blur', () => { hexInput.value = currentHex(); });
        hexInput.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); cpCloseActive(false); } });
        newBox.addEventListener('click', () => cpCloseActive(false));
        currentBox.addEventListener('click', () => { state = cpRgbToHsb(cpHexToRgb(original)); live(render()); });

        function onKey(event) { if (event.key === 'Escape') { event.preventDefault(); cpCloseActive(true); } }
        function onOutside(event) { if (!pop.contains(event.target)) cpCloseActive(false); }
        function onViewportChange() { cpCloseActive(false); }
        function cleanup() {
          pop.remove();
          document.removeEventListener('keydown', onKey, true);
          document.removeEventListener('pointerdown', onOutside, true);
          window.removeEventListener('scroll', onViewportChange, true);
          window.removeEventListener('resize', onViewportChange);
        }
        function restore() { live(original); }

        document.addEventListener('keydown', onKey, true);
        setTimeout(() => document.addEventListener('pointerdown', onOutside, true), 0);
        window.addEventListener('scroll', onViewportChange, true);
        window.addEventListener('resize', onViewportChange);
        cpOpen = { input, load, cleanup, restore };
        document.body.append(pop);
        cpPosition(pop, attach);
        render();
        pop.focus();
      }

      paint();
      return { input, open, paint };
    }

    // ======================================================================
    // Tabs
    // ======================================================================
    function showTab(name) {
      if (!['projects', 'inbox', 'settings'].includes(name)) name = 'projects';
      document.querySelectorAll('.tab-panel').forEach(p => { p.hidden = p.id !== 'tab-' + name; });
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.toggle('active', b.dataset.tab === name));
      if (location.hash !== '#' + name) history.replaceState(null, '', '#' + name);
      document.dispatchEvent(new CustomEvent('tabchange', { detail: { tab: name } }));
    }
    document.querySelectorAll('.tab-btn').forEach(b => b.addEventListener('click', () => showTab(b.dataset.tab)));
    showTab(location.hash.slice(1));
    window.addEventListener('hashchange', () => showTab(location.hash.slice(1)));   // Back/Forward and #links

    // ======================================================================
    // Images: shrink to WebP in the browser, then upload straight to Cloudflare R2.
    // Each image is its own upload and never passes through Vercel, so there's
    // no 4.5 MB limit per image or per batch.
    // ======================================================================
    const MAX_DIMENSION = 2560;   // longest side, in pixels
    const WEBP_QUALITY = 0.85;    // 0 to 1. Higher = sharper but bigger files

    async function decodeImage(file) {
      try { return await createImageBitmap(file, { imageOrientation: 'from-image' }); }
      catch (e) { return await createImageBitmap(file); }   // older browsers don't know that option
    }

    // Returns { file, before, after }. Leaves the file alone when converting wouldn't help.
    async function optimizeImage(file) {
      const type = (file.type || '').toLowerCase();
      const same = { file, before: file.size, after: file.size };
      if (type === 'image/svg+xml' || type === 'image/gif') return same;   // keep vectors and animations as they are
      const isHeic = /heic|heif/.test(type) || /\.(heic|heif)$/i.test(file.name);
      const heicError = new Error(file.name + " is an iPhone HEIC photo this browser can't read. Export it as JPG first, or upload it from Safari.");

      let bitmap;
      try { bitmap = await decodeImage(file); }
      catch (e) { if (isHeic) throw heicError; return same; }

      const scale = Math.min(1, MAX_DIMENSION / Math.max(bitmap.width, bitmap.height));
      const w = Math.max(1, Math.round(bitmap.width * scale));
      const h = Math.max(1, Math.round(bitmap.height * scale));
      const canvas = document.createElement('canvas');
      canvas.width = w; canvas.height = h;
      canvas.getContext('2d').drawImage(bitmap, 0, 0, w, h);
      if (bitmap.close) bitmap.close();

      const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/webp', WEBP_QUALITY));
      if (!blob || blob.type !== 'image/webp') { if (isHeic) throw heicError; return same; }   // browser can't make WebP
      if (blob.size >= file.size && !isHeic) return same;                                     // already smaller as-is
      const out = new File([blob], file.name.replace(/\.[^.]+$/, '') + '.webp', { type: 'image/webp' });
      return { file: out, before: file.size, after: out.size };
    }

    // Uploads one file to R2 exactly as given and returns its public URL.
    async function uploadToR2(file) {
      let res;
      try {
        res = await fetch('/api/upload', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
          body: JSON.stringify({ filename: file.name, contentType: file.type })
        });
      } catch (e) {
        throw new Error("Couldn't reach your server to start the upload. Check your internet connection and try again.");
      }
      let data = {};
      try { data = await res.json(); } catch (e) {}
      if (res.status === 401) throw new Error('Your login expired. Log in again in a new tab, then retry. Your unsaved changes are still here.');
      if (!res.ok) throw new Error(data.error || ('The server failed to prepare the upload (error ' + res.status + ').'));

      let put;
      try {
        put = await fetch(data.uploadUrl, { method: 'PUT', headers: { 'Content-Type': file.type }, body: file });
      } catch (e) {
        throw new Error('Cloudflare R2 blocked the upload of ' + file.name + ". This almost always means the bucket's CORS policy doesn't allow this site yet. Nothing was saved for this image.");
      }
      if (!put.ok) throw new Error('Cloudflare R2 rejected ' + file.name + ' (error ' + put.status + ').');
      return data.finalUrl;
    }

    // Shrink + upload. Returns { url, before, after }.
    async function uploadImage(file) {
      if (file.type && !file.type.startsWith('image/')) throw new Error(file.name + " isn't an image file.");
      const opt = await optimizeImage(file);
      const url = await uploadToR2(opt.file);
      return { url, before: opt.before, after: opt.after };
    }

    function pickFiles(multiple) {
      return new Promise(resolve => {
        const input = document.createElement('input');
        input.type = 'file'; input.accept = 'image/*'; input.multiple = !!multiple;
        input.addEventListener('change', () => resolve(Array.from(input.files || [])));
        input.click();
      });
    }

    // ---- Files dragged in from your computer ----
    const hasFiles = (e) => !!(e.dataTransfer && Array.from(e.dataTransfer.types || []).includes('Files'));
    const imageFiles = (list) => Array.from(list || []).filter(f => /^image\//.test(f.type) || /\.(heic|heif)$/i.test(f.name));
    let fileDragDepth = 0;   // counts enter/leave pairs so highlights don't flicker
    function endFileDrag() {
      fileDragDepth = 0;
      document.body.classList.remove('dragging-files');
      document.querySelectorAll('.file-over').forEach(n => n.classList.remove('file-over'));
    }
    document.addEventListener('dragenter', e => { if (hasFiles(e)) { fileDragDepth++; document.body.classList.add('dragging-files'); } });
    document.addEventListener('dragleave', e => { if (hasFiles(e) && --fileDragDepth <= 0) endFileDrag(); });
    // Stop the browser from opening a file dropped outside a drop area
    document.addEventListener('dragover', e => { if (hasFiles(e)) e.preventDefault(); });
    document.addEventListener('drop', e => { if (hasFiles(e)) { e.preventDefault(); endFileDrag(); } });

    function fileDropTarget(node, onFiles) {
      node.addEventListener('dragover', e => {
        if (!hasFiles(e)) return;
        e.preventDefault(); e.stopPropagation();
        e.dataTransfer.dropEffect = 'copy';
        node.classList.add('file-over');
      });
      node.addEventListener('dragleave', e => { if (!node.contains(e.relatedTarget)) node.classList.remove('file-over'); });
      node.addEventListener('drop', e => {
        if (!hasFiles(e)) return;
        e.preventDefault(); e.stopPropagation();
        endFileDrag();
        onFiles(imageFiles(e.dataTransfer.files), e.dataTransfer.files.length);
      });
    }

    // ======================================================================
    // Logo (uploaded as-is, never converted)
    // ======================================================================
    document.getElementById('logoInput').addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const status = document.getElementById('logoStatus');
      setMsg(status, 'Uploading...');
      try {
        const finalUrl = await uploadToR2(file);
        const form = el('form', { method: 'POST', action: '/admin/settings/logo' }, el('input', { type: 'hidden', name: 'logo_url', value: finalUrl }));
        document.body.appendChild(form);
        form.submit();
      } catch (err) {
        setMsg(status, err.message, 'err');
        toast(err.message, 'err');
      }
    });

    // ======================================================================
    // New project
    // ======================================================================
    (function () {
      let chosen = [];
      const drop = document.getElementById('addDrop');
      const input = document.getElementById('addImages');
      const list = document.getElementById('addList');
      const status = document.getElementById('addStatus');
      const btn = document.getElementById('addBtn');

      function setChosen(files, skipped) {
        chosen = files;
        list.textContent = files.length
          ? files.length + ' image' + (files.length === 1 ? '' : 's') + ' selected (' + fmtSize(files.reduce((s, f) => s + f.size, 0)) + '): ' + files.map(f => f.name).join(', ')
          : '';
        setMsg(status, skipped ? skipped + " file(s) skipped because they aren't images." : '', skipped ? 'err' : '');
      }
      drop.addEventListener('click', () => input.click());
      drop.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); input.click(); } });
      input.addEventListener('change', () => setChosen(imageFiles(input.files), input.files.length - imageFiles(input.files).length));
      fileDropTarget(drop, (files, total) => setChosen(files, total - files.length));

      document.getElementById('addForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const title = document.getElementById('addTitle').value.trim();
        if (!title) return setMsg(status, 'Give the project a title first.', 'err');
        if (!chosen.length) return setMsg(status, 'Add at least one image.', 'err');

        btn.disabled = true;
        try {
          const blocks = [];
          let before = 0, after = 0;
          for (let i = 0; i < chosen.length; i++) {
            setMsg(status, 'Optimizing and uploading image ' + (i + 1) + ' of ' + chosen.length + ' (' + chosen[i].name + ')...');
            const up = await uploadImage(chosen[i]);
            before += up.before; after += up.after;
            blocks.push({ type: 'single', url: up.url });
          }
          setMsg(status, 'Saving the project... (images: ' + fmtSize(before) + ' → ' + fmtSize(after) + ')');
          await api('/api/projects', { title, blocks });
          location.hash = 'projects';
          location.reload();
        } catch (err) {
          setMsg(status, err.message, 'err');
          btn.disabled = false;
        }
      });
    })();

    // ======================================================================
    // Project list: order + visibility
    // ======================================================================
    const projectList = document.getElementById('projectList');
    const items = () => Array.from(projectList.querySelectorAll('.project-item'));
    const itemFor = (id) => projectList.querySelector('.project-item[data-id="' + id + '"]');

    function refreshArrows() {
      const all = items();
      all.forEach((it, i) => {
        it.querySelector('.f-up').disabled = i === 0;
        it.querySelector('.f-down').disabled = i === all.length - 1;
      });
    }
    async function saveOrder() {
      refreshArrows();
      const status = document.getElementById('orderStatus');
      setMsg(status, 'Saving order...');
      try {
        await api('/api/projects/order', { ids: items().map(it => Number(it.dataset.id)) });
        setMsg(status, 'Order saved.', 'ok');
        toast('Project order saved.', 'ok', 2200);
      } catch (err) {
        setMsg(status, err.message, 'err');
      }
    }
    function rowNote(id, text, kind) {
      const n = itemFor(id).querySelector('.row-note');
      n.className = 'row-note' + (kind ? ' ' + kind : '');
      n.textContent = text || '';
    }

    let ROWDRAG = null;
    items().forEach(item => {
      const id = item.dataset.id;
      item.querySelector('.f-up').addEventListener('click', () => {
        const prev = item.previousElementSibling;
        if (prev) { projectList.insertBefore(item, prev); saveOrder(); }
      });
      item.querySelector('.f-down').addEventListener('click', () => {
        const next = item.nextElementSibling;
        if (next) { projectList.insertBefore(next, item); saveOrder(); }
      });

      const vis = item.querySelector('.f-visibility');
      vis.addEventListener('click', async () => {
        const hide = !item.classList.contains('is-hidden');
        vis.disabled = true;
        try {
          await api('/api/projects/' + id + '/visibility', { hidden: hide });
          item.classList.toggle('is-hidden', hide);
          vis.textContent = hide ? 'Show' : 'Hide';
          ORIGINAL[id].hidden = hide;
          rowNote(id, hide ? 'Hidden from the live site.' : 'Visible on the live site.', 'ok');
          toast(hide ? 'Project hidden from the live site.' : 'Project is visible on the live site.', 'ok', 2200);
        } catch (err) {
          rowNote(id, err.message, 'warn');
        } finally {
          vis.disabled = false;
        }
      });

      item.querySelector('.f-edit').addEventListener('click', () => toggleEdit(id));

      const dupBtn = item.querySelector('.f-duplicate');
      dupBtn.addEventListener('click', async () => {
        dupBtn.disabled = true;
        try {
          await api('/api/projects/' + id + '/duplicate');
          toast('Project duplicated. Reloading the list…', 'ok');
          location.reload();
        } catch (err) {
          dupBtn.disabled = false;
          toast(err.message, 'err');
        }
      });


      // Drag a row by its ⠿ handle to reorder
      const handle = item.querySelector('.row-handle');
      handle.addEventListener('dragstart', e => {
        ROWDRAG = item;
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', 'row');
        e.dataTransfer.setDragImage(item.querySelector('.project-row'), 20, 20);
      });
      handle.addEventListener('dragend', () => {
        ROWDRAG = null;
        items().forEach(it => it.classList.remove('drop-before', 'drop-after'));
      });
      item.addEventListener('dragover', e => {
        if (!ROWDRAG || ROWDRAG === item) return;
        e.preventDefault();
        const r = item.querySelector('.project-row').getBoundingClientRect();
        const before = e.clientY < r.top + r.height / 2;
        item.classList.toggle('drop-before', before);
        item.classList.toggle('drop-after', !before);
      });
      item.addEventListener('dragleave', e => { if (!item.contains(e.relatedTarget)) item.classList.remove('drop-before', 'drop-after'); });
      item.addEventListener('drop', e => {
        if (!ROWDRAG || ROWDRAG === item) return;
        e.preventDefault();
        const before = item.classList.contains('drop-before');
        item.classList.remove('drop-before', 'drop-after');
        projectList.insertBefore(ROWDRAG, before ? item : item.nextElementSibling);
        ROWDRAG = null;
        saveOrder();
      });
    });
    refreshArrows();

    // Search + "Hidden only" filter for the project list
    const projectSearch = document.getElementById('projectSearch');
    const hiddenOnly = document.getElementById('hiddenOnly');
    const noProjectMatch = document.getElementById('noProjectMatch');
    function applyProjectFilter() {
      const query = (projectSearch.value || '').trim().toLowerCase();
      const onlyHidden = hiddenOnly.checked;
      let shown = 0;
      items().forEach(item => {
        const title = item.querySelector('.row-title').textContent.toLowerCase();
        const link = item.querySelector('.row-link').textContent.toLowerCase();
        const hidden = item.classList.contains('is-hidden');
        const matches = (!query || title.includes(query) || link.includes(query)) && (!onlyHidden || hidden);
        item.hidden = !matches;
        if (matches) shown++;
      });
      noProjectMatch.hidden = shown > 0 || items().length === 0;
      refreshArrows();
    }
    projectSearch.addEventListener('input', applyProjectFilter);
    projectSearch.addEventListener('search', applyProjectFilter);
    hiddenOnly.addEventListener('change', applyProjectFilter);
    applyProjectFilter();

    // ======================================================================
    // Layout editor
    // ======================================================================
    const ORIGINAL = {};
    DATA.projects.forEach(p => { ORIGINAL[String(p.id)] = p; });
    const S = {};          // working copy per project id
    let DRAG = null;       // image or block being dragged inside an editor

    const panel = (id) => document.getElementById('edit-' + id);

    function fillSelect(select, values, labels, current) {
      select.replaceChildren();
      values.forEach(v => select.append(el('option', { value: v, text: labels[v] || v, selected: Number(v) === Number(current) })));
    }

    function resetState(id) {
      const o = ORIGINAL[id];
      S[id] = {
        title: o.title || '', description: o.description || '', cover: o.cover_image || '',
        blocks: clone(o.blocks || []),
        width: o.content_width, gap: o.block_gap, bg: o.bg_color || '',
        dirty: false, busy: 0
      };
      const p = panel(id);
      p.querySelector('.f-title').value = S[id].title;
      p.querySelector('.f-desc').value = S[id].description;
      fillSelect(p.querySelector('.f-width'), CONFIG.pageWidths, WIDTH_LABELS, S[id].width);
      fillSelect(p.querySelector('.f-gap'), CONFIG.blockGaps, GAP_LABELS, S[id].gap);
      syncBgControls(id);
    }

    function syncBgControls(id) {
      const p = panel(id);
      const useDefault = !S[id].bg;
      p.querySelector('.f-bg-default').checked = useDefault;
      const picker = p.querySelector('.f-bg');
      picker.value = S[id].bg || CONFIG.siteBg;
      picker.disabled = useDefault;
    }

    function setStatus(id, msg, kind) { setMsg(document.getElementById('status-' + id), msg, kind); }

    function changed(id, msg) {
      S[id].dirty = true;
      render(id);
      setStatus(id, msg || 'Unsaved changes.', '');
    }
    function touched(id) { S[id].dirty = true; setStatus(id, 'Unsaved changes.', ''); }

    function firstImage(blocks) {
      for (const b of blocks) {
        if (b.type === 'single') return b.url;
        if (b.type === 'grid') { const img = b.images.find(Boolean); if (img) return img; }
      }
      return '';
    }

    // Image locations: { b: blockIndex, s: slotIndex } (s = null for a single image)
    function getAt(st, loc) { const b = st.blocks[loc.b]; return loc.s === null ? b.url : b.images[loc.s]; }
    function setAt(st, loc, url) { const b = st.blocks[loc.b]; if (loc.s === null) b.url = url; else b.images[loc.s] = url; }
    function clearAt(st, loc) { if (loc.s === null) st.blocks[loc.b]._removed = true; else st.blocks[loc.b].images[loc.s] = null; }
    function sweep(st) { st.blocks = st.blocks.filter(b => !b._removed); }

    // --- Actions ---
    function moveBlock(id, from, to) {
      const st = S[id];
      if (to < 0 || to >= st.blocks.length) return;
      const [blk] = st.blocks.splice(from, 1);
      st.blocks.splice(to, 0, blk);
      changed(id);
    }
    function moveBlockTo(id, from, pos) {   // pos = gap index between blocks
      if (pos === from || pos === from + 1) return;
      const st = S[id];
      const [blk] = st.blocks.splice(from, 1);
      st.blocks.splice(pos > from ? pos - 1 : pos, 0, blk);
      changed(id);
    }
    function removeBlock(id, i) {
      const st = S[id];
      const removed = st.blocks.splice(i, 1)[0];
      if (removed && (removed.url === st.cover || (removed.images || []).includes(st.cover))) st.cover = firstImage(st.blocks);
      changed(id, 'Block removed. Click Cancel to undo, or Save to keep it.');
    }
    function removeImage(id, loc) {
      const st = S[id];
      const url = getAt(st, loc);
      clearAt(st, loc); sweep(st);
      if (url === st.cover) st.cover = firstImage(st.blocks);
      changed(id, 'Image removed. Click Cancel to undo, or Save to keep it.');
    }
    function shiftSlot(id, loc, dir) {
      const imgs = S[id].blocks[loc.b].images;
      const t = loc.s + dir;
      if (t < 0 || t >= imgs.length) return;
      [imgs[loc.s], imgs[t]] = [imgs[t], imgs[loc.s]];
      changed(id);
    }
    function setCover(id, url) { S[id].cover = url; changed(id, 'Cover changed.'); }

    function dropImageOn(id, target) {          // onto an image or grid slot: place it there, swap if occupied
      const st = S[id], src = DRAG.loc;
      if (src.b === target.b && src.s === target.s) return;
      const moving = getAt(st, src), occupant = getAt(st, target);
      setAt(st, target, moving);
      if (occupant) setAt(st, src, occupant); else clearAt(st, src);
      sweep(st);
      changed(id);
    }
    function dropImageAt(id, pos) {             // onto a gap: becomes its own full-width image
      const st = S[id], src = DRAG.loc;
      if (src.s === null && (pos === src.b || pos === src.b + 1)) return;
      const url = getAt(st, src);
      clearAt(st, src);
      st.blocks.splice(pos, 0, { type: 'single', url });
      sweep(st);
      changed(id);
    }

    function setLayout(id, i, rows, cols) {
      const st = S[id], b = st.blocks[i];
      rows = Math.min(10, Math.max(1, parseInt(rows, 10) || 1));
      cols = Math.min(6, Math.max(1, parseInt(cols, 10) || 1));
      const size = rows * cols;
      const keep = b.images.slice(0, size);
      while (keep.length < size) keep.push(null);
      const overflow = b.images.slice(size).filter(Boolean);
      for (let k = 0; k < keep.length && overflow.length; k++) if (!keep[k]) keep[k] = overflow.shift();
      b.rows = rows; b.cols = cols; b.images = keep;
      if (overflow.length) st.blocks.splice(i + 1, 0, ...overflow.map(url => ({ type: 'single', url })));
      changed(id, overflow.length ? overflow.length + " image(s) didn't fit, so they were moved just below the grid." : '');
    }
    function splitGrid(id, i) {
      const st = S[id];
      const singles = st.blocks[i].images.filter(Boolean).map(url => ({ type: 'single', url }));
      st.blocks.splice(i, 1, ...singles);
      changed(id, 'Grid split into separate images.');
    }

    // Picks a grid shape (rows × columns) that fits n images neatly
    function autoLayout(n) {
      if (n <= 1) return [1, 1];
      if (n <= 3) return [1, n];
      if (n === 4) return [2, 2];
      if (n <= 6) return [2, 3];
      if (n <= 9) return [3, 3];
      if (n <= 12) return [3, 4];
      if (n <= 16) return [4, 4];
      return [Math.ceil(n / 6), 6];
    }

    // Uploads files one at a time, calling place(url) for each, with progress in the status line
    async function runUploads(id, files, place, startMsg) {
      const st = S[id];
      if (!files.length) return;
      st.busy++; render(id);
      let ok = 0, before = 0, after = 0, error = null;
      for (let k = 0; k < files.length; k++) {
        setStatus(id, (startMsg ? startMsg + ' ' : '') + 'Optimizing and uploading ' + (k + 1) + ' of ' + files.length + ' (' + files[k].name + ')...', '');
        try {
          const up = await uploadImage(files[k]);
          place(up.url);
          if (!st.cover) st.cover = up.url;
          ok++; before += up.before; after += up.after;
          render(id);
        } catch (err) { error = err; break; }
      }
      st.busy--;
      if (ok) st.dirty = true;
      render(id);
      const sizes = ok ? ' (' + fmtSize(before) + ' → ' + fmtSize(after) + ')' : '';
      if (error) setStatus(id, (ok ? ok + ' uploaded' + sizes + ', then: ' : '') + error.message, 'err');
      else setStatus(id, (startMsg ? startMsg + ' ' : '') + ok + ' image(s) uploaded' + sizes + '. Click Save to publish.', '');
    }

    function addSinglesAt(id, pos, files) {
      let at = pos;
      return runUploads(id, files, url => { S[id].blocks.splice(at++, 0, { type: 'single', url }); });
    }

    function fillGrid(blk, startSlot) {
      return (url) => {
        let t = blk.images.findIndex((u, k) => !u && k >= startSlot);
        if (t === -1) t = blk.images.findIndex(u => !u);
        if (t === -1) {                     // grid is full: add a row
          blk.rows++;
          for (let k = 0; k < blk.cols; k++) blk.images.push(null);
          t = blk.images.findIndex(u => !u);
        }
        blk.images[t] = url;
      };
    }
    function uploadIntoGrid(id, blk, startSlot, files) {
      return runUploads(id, files, fillGrid(blk, startSlot));
    }
    // Files dropped onto a grid: resize the grid to fit everything, then fill it
    function dropFilesIntoGrid(id, blk, files) {
      const existing = blk.images.filter(Boolean);
      const [r, c] = autoLayout(existing.length + files.length);
      blk.rows = r; blk.cols = c;
      blk.images = existing.concat(Array(r * c - existing.length).fill(null));
      S[id].dirty = true;
      return runUploads(id, files, fillGrid(blk, 0), 'Grid set to ' + r + ' × ' + c + '.');
    }

    // --- Moving things inside the editor (drag and drop) ---
    function startDrag(e, payload, dragImageEl) {
      DRAG = payload;
      e.dataTransfer.effectAllowed = 'move';
      e.dataTransfer.setData('text/plain', 'move');   // Firefox needs data set to start a drag
      if (dragImageEl) e.dataTransfer.setDragImage(dragImageEl, 20, 20);
      document.body.classList.add('dragging');
    }
    function endDrag() {
      DRAG = null;
      document.body.classList.remove('dragging');
      document.querySelectorAll('.over').forEach(n => n.classList.remove('over'));
    }
    document.addEventListener('dragend', endDrag);
    // Stop the browser from opening a dragged image as a new page
    document.addEventListener('dragover', e => { if (DRAG) e.preventDefault(); });
    document.addEventListener('drop', e => { if (DRAG) { e.preventDefault(); endDrag(); } });

    function dropTarget(node, accepts, onDrop) {
      node.addEventListener('dragover', e => {
        if (DRAG && accepts(DRAG)) { e.preventDefault(); e.stopPropagation(); node.classList.add('over'); }
      });
      node.addEventListener('dragleave', e => { if (!node.contains(e.relatedTarget)) node.classList.remove('over'); });
      node.addEventListener('drop', e => {
        if (!DRAG || !accepts(DRAG)) return;
        e.preventDefault(); e.stopPropagation();
        const d = DRAG;
        onDrop(d);
        endDrag();
      });
    }

    // --- Rendering ---
    function imageTile(id, loc, url, wide) {
      const st = S[id];
      const tile = el('div', { class: 'tile' + (wide ? ' wide' : '') });
      const img = el('img', { src: url, alt: '', draggable: 'true' });
      img.addEventListener('error', () => tile.classList.add('broken'));
      img.addEventListener('dragstart', e => startDrag(e, { kind: 'img', id, loc }, img));
      tile.append(img, el('div', { class: 'missing', text: 'Image file not found. Remove it with ✕.' }));
      if (url === st.cover) tile.append(el('span', { class: 'cover-badge', text: 'Cover' }));

      const bar = el('div', { class: 'tile-bar' });
      if (loc.s !== null) {
        const n = st.blocks[loc.b].images.length;
        bar.append(el('button', { type: 'button', title: 'Move left', text: '◀', disabled: loc.s === 0, onclick: () => shiftSlot(id, loc, -1) }));
        bar.append(el('button', { type: 'button', title: 'Move right', text: '▶', disabled: loc.s === n - 1, onclick: () => shiftSlot(id, loc, 1) }));
      }
      bar.append(el('button', { type: 'button', class: url === st.cover ? 'on' : '', title: url === st.cover ? 'This is the cover' : 'Use as cover', text: '★', onclick: () => setCover(id, url) }));
      bar.append(el('button', { type: 'button', title: 'Remove image', text: '✕', onclick: () => removeImage(id, loc) }));
      tile.append(bar);

      dropTarget(tile, d => d.kind === 'img' && d.id === id, () => dropImageOn(id, loc));
      return tile;
    }

    function emptySlot(id, i, s) {
      const blk = S[id].blocks[i];
      const tile = el('div', { class: 'tile empty' },
        mini('+ Add image', 'Upload one or more images into this grid', async () => uploadIntoGrid(id, blk, s, await pickFiles(true))));
      dropTarget(tile, d => d.kind === 'img' && d.id === id, () => dropImageOn(id, { b: i, s }));
      return tile;
    }

    function gapZone(id, pos) {
      const z = el('div', { class: 'dz', title: 'Drop here' });
      dropTarget(z, d => d.id === id, d => (d.kind === 'blk' ? moveBlockTo(id, d.b, pos) : dropImageAt(id, pos)));
      fileDropTarget(z, files => addSinglesAt(id, pos, files));
      return z;
    }

    const PRESETS = ['1x2', '1x3', '1x4', '2x2', '2x3', '3x2', '3x3', '2x4'];

    function blockCard(id, b, i) {
      const st = S[id];
      const card = el('div', { class: 'blk' });
      const handle = el('span', { class: 'handle', title: 'Drag to move this block', draggable: 'true', text: '⠿' });
      handle.addEventListener('dragstart', e => startDrag(e, { kind: 'blk', id, b: i }, card));

      const head = el('div', { class: 'blk-head' }, handle);
      if (b.type === 'single') head.append(el('span', { class: 'blk-label', text: 'Image' }));
      if (b.type === 'embed') head.append(el('span', { class: 'blk-label', text: 'Embed' }));
      if (b.type === 'grid') {
        head.append(el('span', { class: 'blk-label', text: 'Grid' }));
        const rows = el('input', { type: 'number', min: '1', max: '10', value: b.rows, title: 'Rows' });
        const cols = el('input', { type: 'number', min: '1', max: '6', value: b.cols, title: 'Columns' });
        rows.addEventListener('change', () => setLayout(id, i, rows.value, b.cols));
        cols.addEventListener('change', () => setLayout(id, i, b.rows, cols.value));
        const preset = el('select', { title: 'Layout presets (rows × columns)' }, el('option', { value: '', text: 'Presets…' }));
        PRESETS.forEach(p => { const [r, c] = p.split('x'); preset.append(el('option', { value: p, text: r + ' × ' + c })); });
        preset.addEventListener('change', () => { if (preset.value) { const [r, c] = preset.value.split('x'); setLayout(id, i, r, c); } });
        const gap = el('select', { title: 'Space between images in this grid' });
        [['0', 'No spacing'], ['0.5', 'Tight'], ['1.5', 'Normal'], ['3', 'Wide']].forEach(([v, t]) => {
          gap.append(el('option', { value: v, text: t, selected: Number(v) === Number(b.gap ?? 1.5) }));
        });
        gap.addEventListener('change', () => { b.gap = Number(gap.value); changed(id); });
        head.append(rows, el('span', { text: 'rows ×' }), cols, el('span', { text: 'columns' }), preset, gap,
          mini('Split up', 'Turn this grid back into separate full-width images', () => splitGrid(id, i)));
      }
      head.append(el('span', { class: 'grow' }),
        mini('↑', 'Move up', () => moveBlock(id, i, i - 1), { disabled: i === 0 }),
        mini('↓', 'Move down', () => moveBlock(id, i, i + 1), { disabled: i === st.blocks.length - 1 }),
        mini('Remove', 'Remove this whole block', () => removeBlock(id, i), { class: 'mini danger' }));
      card.append(head);

      if (b.type === 'single') {
        card.append(imageTile(id, { b: i, s: null }, b.url, true));
        fileDropTarget(card, files => addSinglesAt(id, i + 1, files));
      }
      if (b.type === 'grid') {
        const g = el('div', { class: 'grid-edit' });
        g.style.gridTemplateColumns = 'repeat(' + b.cols + ', 1fr)';
        b.images.forEach((url, s) => g.append(url ? imageTile(id, { b: i, s }, url, false) : emptySlot(id, i, s)));
        card.append(g);
        card.title = 'Drop image files here to add them to this grid';
        fileDropTarget(card, files => dropFilesIntoGrid(id, b, files));
      }
      if (b.type === 'embed') {
        const ta = el('textarea', { class: 'embed-code', rows: '3', placeholder: 'Paste iframe embed code here. An empty embed is dropped when you save.' });
        ta.value = b.code || '';
        ta.addEventListener('input', () => { b.code = ta.value; touched(id); });
        card.append(ta);
        fileDropTarget(card, files => addSinglesAt(id, i + 1, files));
      }
      return card;
    }

    function render(id) {
      const st = S[id];
      const root = document.getElementById('layout-' + id);
      root.replaceChildren();
      root.classList.toggle('busy', st.busy > 0);
      if (!st.blocks.length) {
        root.append(el('div', { class: 'layout-empty', text: 'No images yet. Drag image files here, or use “+ Add images” or “+ Add grid” below.' }));
      } else {
        root.append(gapZone(id, 0));
        st.blocks.forEach((b, i) => { root.append(blockCard(id, b, i), gapZone(id, i + 1)); });
      }
      const p = panel(id);
      const prev = p.querySelector('.f-cover-preview');
      if (st.cover) prev.src = st.cover; else prev.removeAttribute('src');
      p.querySelector('.f-save').disabled = st.busy > 0;
    }

    function openEditor(id) {
      if (!S[id]) resetState(id);
      render(id);
      panel(id).classList.add('active');
      itemFor(id).querySelector('.f-edit').textContent = 'Close';
      rowNote(id, '');
    }
    function collapse(id) {
      panel(id).classList.remove('active');
      itemFor(id).querySelector('.f-edit').textContent = 'Edit';
      if (S[id] && (S[id].dirty || S[id].busy)) rowNote(id, 'Unsaved changes. Click Edit to finish.', 'warn');
    }
    function toggleEdit(id) {
      id = String(id);
      if (panel(id).classList.contains('active')) collapse(id); else openEditor(id);
    }

    async function save(id) {
      const st = S[id];
      const btn = panel(id).querySelector('.f-save');
      if (!st.title.trim()) return setStatus(id, 'The project needs a title.', 'err');
      btn.disabled = true;
      setStatus(id, 'Saving...', '');
      try {
        const data = await api('/api/projects/' + id, {
          title: st.title, description: st.description, cover_image: st.cover, blocks: st.blocks,
          bg_color: st.bg, block_gap: st.gap, content_width: st.width
        });
        ORIGINAL[id] = Object.assign({}, ORIGINAL[id], {
          title: st.title.trim(), description: st.description, cover_image: data.cover_image, blocks: data.blocks,
          slug: data.slug, bg_color: data.bg_color, block_gap: data.block_gap, content_width: data.content_width
        });
        resetState(id);   // working copy now matches what was saved
        const item = itemFor(id);
        item.querySelector('.row-title').textContent = ORIGINAL[id].title;
        if (data.cover_image) item.querySelector('.row-thumb').src = data.cover_image;
        const link = item.querySelector('.row-link');
        link.href = '/project/' + data.slug;
        link.textContent = '/project/' + data.slug;
        setStatus(id, '');
        collapse(id);
        rowNote(id, 'Saved. Your site is updated.', 'ok');
        toast('Project saved. Your site is updated.', 'ok');
      } catch (err) {
        setStatus(id, err.message, 'err');
      } finally {
        btn.disabled = st.busy > 0;
      }
    }

    // --- Wire up each edit panel ---
    document.querySelectorAll('.edit-panel').forEach(p => {
      const id = p.dataset.id;
      p.querySelector('.f-title').addEventListener('input', e => { S[id].title = e.target.value; touched(id); });
      p.querySelector('.f-desc').addEventListener('input', e => { S[id].description = e.target.value; touched(id); });
      p.querySelector('.f-width').addEventListener('change', e => { S[id].width = Number(e.target.value); touched(id); });
      p.querySelector('.f-gap').addEventListener('change', e => { S[id].gap = Number(e.target.value); touched(id); });
      p.querySelector('.f-bg-default').addEventListener('change', e => {
        S[id].bg = e.target.checked ? '' : p.querySelector('.f-bg').value;
        syncBgControls(id); touched(id);
      });
      p.querySelector('.f-bg').addEventListener('input', e => { S[id].bg = e.target.value; touched(id); });
      p.querySelector('.f-cover-upload').addEventListener('click', async () => {
        const files = await pickFiles(false);
        await runUploads(id, files, url => { S[id].cover = url; });
      });
      p.querySelector('.f-add-images').addEventListener('click', async () => {
        const files = await pickFiles(true);
        await addSinglesAt(id, S[id].blocks.length, files);
      });
      p.querySelector('.f-add-grid').addEventListener('click', () => {
        S[id].blocks.push({ type: 'grid', rows: 1, cols: 2, gap: 1.5, images: [null, null] });
        changed(id, 'Empty grid added at the bottom. Drag images or image files into it, or use “+ Add image” in a slot.');
      });
      p.querySelector('.f-add-embed').addEventListener('click', () => {
        S[id].blocks.push({ type: 'embed', code: '' });
        changed(id, 'Embed added at the bottom. Paste the iframe code into it.');
      });
      p.querySelector('.f-save').addEventListener('click', () => save(id));
      p.querySelector('.f-cancel').addEventListener('click', () => {
        if (S[id].dirty && !confirm('Discard your unsaved changes to this project?')) return;
        resetState(id);
        render(id);
        setStatus(id, '');
        collapse(id);
        rowNote(id, '');
      });
      p.querySelector('.f-collapse').addEventListener('click', () => collapse(id));
      // Image files dropped anywhere else in the layout get added at the end
      fileDropTarget(document.getElementById('layout-' + id), files => addSinglesAt(id, S[id].blocks.length, files));
    });

    window.addEventListener('beforeunload', e => {
      const projectDirty = Object.values(S).some(st => st.dirty || st.busy);
      if (projectDirty || hasSettingsChanges()) { e.preventDefault(); e.returnValue = ''; }
    });

    // ======================================================================
    // Inbox
    // ======================================================================
    const MESSAGES = DATA.messages;
    const inboxList = document.getElementById('inboxList');
    const fmtDate = (iso) => { const d = new Date(iso); return isNaN(d) ? '' : d.toLocaleString(undefined, { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }); };

    function updateUnread() {
      const n = MESSAGES.filter(m => !m.is_read).length;
      document.getElementById('unreadBadge').textContent = n ? String(n) : '';
    }

    function renderInbox() {
      inboxList.replaceChildren();
      updateUnread();
      if (!MESSAGES.length) {
        inboxList.append(el('div', { class: 'inbox-empty', text: 'No messages yet. Anything sent from your Contact page will show up here.' }));
        return;
      }
      MESSAGES.forEach(m => {
        const item = el('div', { class: 'msg' + (m.is_read ? '' : ' unread') });
        const body = el('div', { class: 'msg-body', hidden: true },
          el('div', { class: 'msg-email' }, el('a', { href: 'mailto:' + encodeURIComponent(m.email) + '?subject=' + encodeURIComponent('Re: your message'), text: m.email })),
          el('p', { class: 'msg-text', text: m.message }),
          el('div', { class: 'msg-actions' },
            el('a', { class: 'mini', href: 'mailto:' + encodeURIComponent(m.email) + '?subject=' + encodeURIComponent('Re: your message'), text: 'Reply by email' }),
            mini('Mark as unread', 'Show this as unread again', () => setRead(m, item, false)),
            mini('Delete', 'Delete this message', () => deleteMessage(m, item), { class: 'mini danger' })));
        const head = el('button', { type: 'button', class: 'msg-head', title: 'Open message' },
          el('span', { class: 'dot' }),
          el('span', { class: 'msg-from', text: m.name }),
          el('span', { class: 'msg-preview', text: m.message.replace(/\s+/g, ' ').slice(0, 120) }),
          el('span', { class: 'msg-date', text: fmtDate(m.created_at) }));
        head.addEventListener('click', () => {
          body.hidden = !body.hidden;
          if (!body.hidden && !m.is_read) setRead(m, item, true);
        });
        item.append(head, body);
        inboxList.append(item);
      });
    }

    async function setRead(m, item, read) {
      const prev = m.is_read;
      m.is_read = read;
      item.classList.toggle('unread', !read);
      updateUnread();
      try { await api('/api/messages/' + m.id + '/read', { read }); }
      catch (err) {
        m.is_read = prev; item.classList.toggle('unread', !prev); updateUnread();
        setMsg(document.getElementById('inboxStatus'), err.message, 'err');
      }
    }
    async function deleteMessage(m, item) {
      if (!confirm('Delete this message from ' + m.name + '? This can\'t be undone.')) return;
      try {
        await api('/api/messages/' + m.id + '/delete');
        MESSAGES.splice(MESSAGES.indexOf(m), 1);
        renderInbox();
        setMsg(document.getElementById('inboxStatus'), 'Message deleted.', 'ok');
        toast('Message deleted.', 'ok', 2500);
      } catch (err) {
        setMsg(document.getElementById('inboxStatus'), err.message, 'err');
      }
    }
    renderInbox();

    // ======================================================================
    // Site settings: appearance + content drafts, live preview, save bar
    // ======================================================================
    // These defaults mirror APPEARANCE-CONTRACT.md + V2-CONTRACT.md. They only make the form
    // usable; the server always validates and its sanitized response is authoritative.
    const APPEARANCE_DEFAULTS = {
      home: { columns: 3, columnsMobile: 1, maxWidth: -1, gapX: 2, gapY: 4, coverRatio: '4/3', coverFit: 'cover', titleSize: 1, titleWeight: 400, showTitles: true },
      project: { titleSize: 2.5, descriptionWidth: 600, defaultWidth: 1100, defaultGap: 2, carouselShow: true, carouselItemWidth: 280, carouselCoverRatio: '4/3' },
      type: { font: 'open-sans', scale: 1, headingWeight: 600, navSize: 0.85, navSpacing: 1.5, navUppercase: true },
      header: { layout: 'nav-left', logoHeight: 40, paddingY: 1.5, paddingX: 4, sticky: true },
      colors: { navActive: '#ff5a36', titleHover: '#ff5a36', logo: '', favicon: '' }
    };
    const CONTENT_DEFAULTS = {
      seo: { siteName: 'Jon Messier', homeTitle: 'Jon Messier | Portfolio', description: '', ogImage: '', favicon: '' },
      contact: { heading: 'Contact', intro: "Have a project in mind or a question? Send a message and I'll get back to you.", success: 'Thanks! Your message was sent.', email: '' },
      about: {
        eyebrow: 'About me',
        headline: "I'm Jon Messier.",
        subhead: 'But I am also...',
        roles: 'A visual storyteller.\nA restless learner.\nA curious generalist.',
        intro: "I'm a multidisciplinary designer focused on visual storytelling, typography, and design that connects with people.",
        quote: 'For me, a project reaches perfection not when there is nothing left to add, but when there is nothing left to take away.',
        quoteText: 'Good design should feel effortless, refined down to the essentials, yet strong enough to resonate and endure.',
        headshot: '',
        buttonText: "Let's get in touch!",
        buttonUrl: '/contact'
      },
      footer: { show: true, text: '', social: [] }
    };

    const isHexColor = (v) => typeof v === 'string' && /^#[0-9a-fA-F]{6}$/.test(v);
    const isHttpUrl = (v) => typeof v === 'string' && /^https?:\/\//i.test(v);
    const clampIntValue = (v, min, max, fallback) => { const n = parseInt(v, 10); return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback; };
    const clampNumberValue = (v, min, max, fallback) => { const n = Number(v); return Number.isFinite(n) ? Math.min(max, Math.max(min, Math.round(n * 100) / 100)) : fallback; };
    const pickOne = (v, allowed, fallback) => (allowed.includes(v) ? v : fallback);
    const pickNumber = (v, allowed, fallback) => (allowed.map(Number).includes(Number(v)) ? Number(v) : fallback);
    const asBool = (v, fallback) => (typeof v === 'boolean' ? v : fallback);
    const asText = (v, fallback) => (typeof v === 'string' ? v : fallback);

    // Clamps every appearance value to the enums/range in the contract, filling in defaults.
    function sanitizeAppearance(raw) {
      const src = raw && typeof raw === 'object' ? raw : {};
      const home = src.home || {}, project = src.project || {}, type = src.type || {}, header = src.header || {}, colors = src.colors || {};
      return {
        home: {
          columns: clampIntValue(home.columns, 1, 4, 3),
          columnsMobile: clampIntValue(home.columnsMobile, 1, 2, 1),
          maxWidth: pickNumber(home.maxWidth, [-1, 0, 860, 1100, 1300, 1500], -1),
          gapX: clampNumberValue(home.gapX, 0, 4, 2),
          gapY: clampNumberValue(home.gapY, 1, 6, 4),
          coverRatio: pickOne(home.coverRatio, ['4/3', '3/2', '16/9', '1/1', 'natural'], '4/3'),
          coverFit: pickOne(home.coverFit, ['cover', 'contain'], 'cover'),
          titleSize: clampNumberValue(home.titleSize, 0.8, 1.6, 1),
          titleWeight: pickNumber(home.titleWeight, [400, 600, 700], 400),
          showTitles: asBool(home.showTitles, true)
        },
        project: {
          titleSize: clampNumberValue(project.titleSize, 1.6, 3.2, 2.5),
          descriptionWidth: clampIntValue(project.descriptionWidth, 420, 860, 600),
          defaultWidth: pickNumber(project.defaultWidth, [640, 860, 1100, 1400], 1100),
          defaultGap: pickNumber(project.defaultGap, [0, 1, 2, 4], 2),
          carouselShow: asBool(project.carouselShow, true),
          carouselItemWidth: clampIntValue(project.carouselItemWidth, 200, 360, 280),
          carouselCoverRatio: pickOne(project.carouselCoverRatio, ['4/3', '3/2', '16/9', '1/1'], '4/3')
        },
        type: {
          font: pickOne(type.font, ['open-sans', 'inter', 'source-sans', 'georgia', 'system'], 'open-sans'),
          scale: clampNumberValue(type.scale, 0.9, 1.15, 1),
          headingWeight: pickNumber(type.headingWeight, [500, 600, 700], 600),
          navSize: clampNumberValue(type.navSize, 0.7, 1, 0.85),
          navSpacing: clampNumberValue(type.navSpacing, 0, 3, 1.5),
          navUppercase: asBool(type.navUppercase, true)
        },
        header: {
          layout: pickOne(header.layout, ['nav-left', 'logo-left'], 'nav-left'),
          logoHeight: clampIntValue(header.logoHeight, 24, 72, 40),
          paddingY: clampNumberValue(header.paddingY, 0.75, 2.5, 1.5),
          paddingX: clampNumberValue(header.paddingX, 1, 5, 4),
          sticky: asBool(header.sticky, true)
        },
        colors: {
          navActive: isHexColor(colors.navActive) ? colors.navActive.toLowerCase() : '#ff5a36',
          titleHover: isHexColor(colors.titleHover) ? colors.titleHover.toLowerCase() : '#ff5a36',
          logo: isHexColor(colors.logo) ? colors.logo.toLowerCase() : '',
          favicon: isHexColor(colors.favicon) ? colors.favicon.toLowerCase() : ''
        }
      };
    }

    // Same idea for content; social links are capped at 4, URLs are checked, roles are capped at 6 lines.
    function sanitizeContent(raw) {
      const src = raw && typeof raw === 'object' ? raw : {};
      const seo = src.seo || {}, contact = src.contact || {}, about = src.about || {}, footer = src.footer || {};
      const social = Array.isArray(footer.social)
        ? footer.social.slice(0, 4).map(s => ({ label: asText(s && s.label, ''), url: asText(s && s.url, '') }))
        : [];
      const roles = asText(about.roles, CONTENT_DEFAULTS.about.roles)
        .replace(/\r\n/g, '\n').replace(/\r/g, '\n').split('\n').slice(0, 6).join('\n');
      return {
        seo: {
          siteName: asText(seo.siteName, CONTENT_DEFAULTS.seo.siteName),
          homeTitle: asText(seo.homeTitle, CONTENT_DEFAULTS.seo.homeTitle),
          description: asText(seo.description, ''),
          ogImage: isHttpUrl(seo.ogImage) ? seo.ogImage : '',
          favicon: isHttpUrl(seo.favicon) ? seo.favicon : ''
        },
        contact: {
          heading: asText(contact.heading, CONTENT_DEFAULTS.contact.heading),
          intro: asText(contact.intro, CONTENT_DEFAULTS.contact.intro),
          success: asText(contact.success, CONTENT_DEFAULTS.contact.success),
          email: asText(contact.email, '')
        },
        about: {
          eyebrow: asText(about.eyebrow, CONTENT_DEFAULTS.about.eyebrow),
          headline: asText(about.headline, CONTENT_DEFAULTS.about.headline),
          subhead: asText(about.subhead, CONTENT_DEFAULTS.about.subhead),
          roles,
          intro: asText(about.intro, CONTENT_DEFAULTS.about.intro),
          quote: asText(about.quote, CONTENT_DEFAULTS.about.quote),
          quoteText: asText(about.quoteText, CONTENT_DEFAULTS.about.quoteText),
          headshot: isHttpUrl(about.headshot) ? about.headshot : '',
          buttonText: asText(about.buttonText, CONTENT_DEFAULTS.about.buttonText),
          buttonUrl: asText(about.buttonUrl, CONTENT_DEFAULTS.about.buttonUrl)
        },
        footer: { show: asBool(footer.show, true), text: asText(footer.text, ''), social }
      };
    }

    const DRAFTS = {
      appearance: sanitizeAppearance(DATA.appearance),
      content: sanitizeContent(DATA.content)
    };
    const SAVED = { appearance: clone(DRAFTS.appearance), content: clone(DRAFTS.content) };
    const BG = {
      saved: isHexColor(CONFIG.siteBg) ? CONFIG.siteBg : '#181818',
      value: isHexColor(CONFIG.siteBg) ? CONFIG.siteBg : '#181818'
    };
    // Branding info from the server (raw uploaded files). Falls back to the v1 locals and the
    // uploaded filenames while the V2 server is still landing.
    const BRANDING = (function () {
      const raw = DATA.branding || {};
      const isSvgUrl = (url) => typeof url === 'string' && /\.svg(?:[?#]|$)/i.test(url);
      const logoUrl = raw.logoUrl || DATA.logoUrl || '';
      const faviconUrl = raw.faviconUrl || (DRAFTS.content.seo && DRAFTS.content.seo.favicon) || '';
      return {
        logoUrl,
        faviconUrl,
        logoIsSvg: typeof raw.logoIsSvg === 'boolean' ? raw.logoIsSvg : isSvgUrl(logoUrl),
        faviconIsSvg: typeof raw.faviconIsSvg === 'boolean' ? raw.faviconIsSvg : isSvgUrl(faviconUrl)
      };
    })();

    // ---- Draft object path helpers ----
    function getPath(obj, path) {
      return path.split('.').reduce((node, key) => (node == null ? undefined : node[key]), obj);
    }
    function setPath(obj, path, value) {
      const keys = path.split('.');
      let node = obj;
      for (let i = 0; i < keys.length - 1; i++) {
        if (node[keys[i]] == null || typeof node[keys[i]] !== 'object') node[keys[i]] = {};
        node = node[keys[i]];
      }
      node[keys[keys.length - 1]] = value;
    }
    function syncField(node) {
      const value = getPath(DRAFTS[node.dataset.draft], node.dataset.path);
      if (node.type === 'checkbox') node.checked = !!value;
      else node.value = value == null ? '' : String(value);
    }
    function syncAppearanceControls() {
      document.querySelectorAll('[data-draft="appearance"]').forEach(syncField);
      syncColorControls();
    }
    function syncContentControls() {
      document.querySelectorAll('[data-draft="content"]').forEach(syncField);
      renderSocialRows();
      renderSeoPreviews();
      renderAboutHeadshotPreview();
    }

    // ---- Dirty state + save bar ----
    function hasSettingsChanges() {
      return JSON.stringify(DRAFTS.appearance) !== JSON.stringify(SAVED.appearance)
        || JSON.stringify(DRAFTS.content) !== JSON.stringify(SAVED.content)
        || BG.value !== BG.saved;
    }
    function updateSaveBar() {
      const dirty = hasSettingsChanges();
      const note = document.getElementById('settingsDirty');
      note.textContent = dirty ? 'Unsaved changes' : 'All settings saved';
      note.classList.toggle('dirty', dirty);
      document.getElementById('settingsSave').disabled = !dirty;
      document.getElementById('settingsDiscard').disabled = !dirty;
    }
    let previewTimer = null;
    function settingsTouched() {
      updateSaveBar();
      clearTimeout(previewTimer);
      previewTimer = setTimeout(applyPreview, 120);
    }

    // ---- Every [data-draft] control edits the draft; numbers clamp on commit ----
    document.querySelectorAll('[data-draft]').forEach(node => {
      const kind = node.dataset.kind || (node.type === 'checkbox' ? 'bool' : 'text');
      const draftName = node.dataset.draft;
      const path = node.dataset.path;
      const apply = (commit) => {
        if (kind === 'bool') {
          setPath(DRAFTS[draftName], path, node.checked);
        } else if (kind === 'number') {
          const raw = String(node.value).trim();
          if (raw === '' || !Number.isFinite(Number(raw))) { if (commit) syncField(node); return; }
          let value = Number(raw);
          if (commit) {
            // input[type=number] exposes min/max; <select> does not (its options are already valid).
            const hasMin = node.min != null && node.min !== '' && Number.isFinite(Number(node.min));
            const hasMax = node.max != null && node.max !== '' && Number.isFinite(Number(node.max));
            value = Math.min(hasMax ? Number(node.max) : Infinity, Math.max(hasMin ? Number(node.min) : -Infinity, value));
            if (String(value) !== node.value) node.value = String(value);
          }
          setPath(DRAFTS[draftName], path, value);
        } else {
          setPath(DRAFTS[draftName], path, node.value);
        }
        settingsTouched();
      };
      node.addEventListener('input', () => apply(false));
      node.addEventListener('change', () => apply(true));
    });

    // ---- Colors card: pickers + logo/favicon tint logic ----
    const colorNavInput = document.getElementById('setColorNavActive');
    const colorTitleInput = document.getElementById('setColorTitleHover');
    const colorLogoInput = document.getElementById('setColorLogo');
    const colorFaviconInput = document.getElementById('setColorFavicon');
    const tintLogoCheck = document.getElementById('tintLogo');
    const tintFaviconCheck = document.getElementById('tintFavicon');
    const logoTintHint = document.getElementById('logoTintHint');
    const faviconTintHint = document.getElementById('faviconTintHint');
    const lastTint = { logo: '#ff5a36', favicon: '#ff5a36' };

    attachColorPicker(colorNavInput, { title: 'Nav active color' });
    attachColorPicker(colorTitleInput, { title: 'Project title hover color' });
    attachColorPicker(colorLogoInput, { title: 'Logo tint color', fallback: '#ff5a36' });
    attachColorPicker(colorFaviconInput, { title: 'Favicon tint color', fallback: '#ff5a36' });
    attachColorPicker(document.getElementById('siteBgPicker'), { title: 'Site background color' });
    document.querySelectorAll('.f-bg').forEach(input => attachColorPicker(input, { title: 'Project background color' }));

    const tintSupported = (kind) => (kind === 'logo' ? BRANDING.logoIsSvg : BRANDING.faviconIsSvg);
    const tintInput = (kind) => (kind === 'logo' ? colorLogoInput : colorFaviconInput);
    const tintCheckbox = (kind) => (kind === 'logo' ? tintLogoCheck : tintFaviconCheck);
    const tintHintEl = (kind) => (kind === 'logo' ? logoTintHint : faviconTintHint);

    // Refreshes the tint checkboxes/pickers from the appearance draft (and SVG support).
    function syncColorControls() {
      ['logo', 'favicon'].forEach(kind => {
        const input = tintInput(kind), checkbox = tintCheckbox(kind), hint = tintHintEl(kind);
        const supported = tintSupported(kind);
        const color = DRAFTS.appearance.colors[kind] || '';
        if (isHexColor(color)) lastTint[kind] = color;
        checkbox.disabled = !supported;
        checkbox.checked = supported && !!color;
        input.disabled = !supported || !color;
        input.value = color || lastTint[kind];
        if (!supported) {
          hint.textContent = kind === 'logo'
            ? 'Tint only works with an SVG logo. Upload an SVG logo to enable it.'
            : 'Tint only works with an SVG favicon. Upload an SVG favicon to enable it.';
        } else {
          hint.textContent = color ? 'The uploaded SVG is recolored on every page.' : 'Turn on to recolor the uploaded SVG.';
        }
      });
    }
    function onTintToggle(kind) {
      const checkbox = tintCheckbox(kind), input = tintInput(kind);
      if (checkbox.disabled) return;
      if (checkbox.checked) {
        const current = DRAFTS.appearance.colors[kind];
        const color = isHexColor(input.value) ? input.value.toLowerCase() : (isHexColor(current) ? current : lastTint[kind]);
        DRAFTS.appearance.colors[kind] = color;
        lastTint[kind] = color;
        input.value = color;
      } else {
        if (isHexColor(input.value)) lastTint[kind] = input.value.toLowerCase();
        DRAFTS.appearance.colors[kind] = '';
      }
      syncColorControls();
      settingsTouched();
    }
    tintLogoCheck.addEventListener('change', () => onTintToggle('logo'));
    tintFaviconCheck.addEventListener('change', () => onTintToggle('favicon'));
    // The live picker dispatches "input"; make sure a tinted value only sticks while its checkbox is on.
    ['logo', 'favicon'].forEach(kind => {
      tintInput(kind).addEventListener('input', () => {
        const value = tintInput(kind).value;
        const enabled = tintCheckbox(kind).checked;
        DRAFTS.appearance.colors[kind] = enabled && isHexColor(value) ? value.toLowerCase() : '';
        if (enabled && isHexColor(value)) lastTint[kind] = value.toLowerCase();
        settingsTouched();
      });
    });

    // ---- Live preview of the Portfolio page (unsaved draft applied as CSS variables) ----
    const previewFrame = document.getElementById('livePreview');
    const previewWrap = document.getElementById('previewWrap');
    const FONT_STACKS = {
      'open-sans': "'Open Sans', sans-serif",
      inter: "'Inter', sans-serif",
      'source-sans': "'Source Sans 3', sans-serif",
      georgia: "Georgia, 'Times New Roman', serif",
      system: "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
    };
    function previewDoc() {
      try { return previewFrame.contentDocument; } catch (e) { return null; }
    }
    // Exact custom property names/formats from the contract (§2).
    function appearanceCssVars(a) {
      const ratio = (r) => (r === 'natural' ? 'auto' : r.split('/').join(' / '));
      return {
        '--font-body': FONT_STACKS[a.type.font],
        '--font-size': String(+(16 * a.type.scale).toFixed(2)) + 'px',
        '--heading-weight': String(a.type.headingWeight),
        '--nav-size': a.type.navSize + 'rem',
        '--nav-spacing': a.type.navSpacing + 'px',
        '--nav-transform': a.type.navUppercase ? 'uppercase' : 'none',
        '--logo-height': a.header.logoHeight + 'px',
        '--header-position': a.header.sticky ? 'sticky' : 'static',
        '--header-pad-y': a.header.paddingY + 'rem',
        '--header-pad-x': a.header.paddingX + 'rem',
        '--home-cols': String(a.home.columns),
        '--home-cols-mobile': String(a.home.columnsMobile),
        '--home-max': a.home.maxWidth === 0 ? 'none' : a.home.maxWidth === -1 ? 'calc(80vw + 3rem)' : a.home.maxWidth + 'px',
        '--home-gap-x': a.home.gapX + 'rem',
        '--home-gap-y': a.home.gapY + 'rem',
        '--home-cover-ratio': ratio(a.home.coverRatio),
        '--home-cover-fit': a.home.coverFit,
        '--home-title-size': a.home.titleSize + 'rem',
        '--home-title-weight': String(a.home.titleWeight),
        '--home-title-display': a.home.showTitles ? 'block' : 'none',
        '--project-title-size': a.project.titleSize + 'rem',
        '--project-desc-width': a.project.descriptionWidth + 'px',
        '--carousel-item-width': a.project.carouselItemWidth + 'px',
        '--carousel-cover-ratio': ratio(a.project.carouselCoverRatio),
        '--nav-active-color': a.colors.navActive,
        '--title-hover-color': a.colors.titleHover,
        '--accent': a.colors.navActive,
        '--font-display': "'Instrument Serif', Georgia, 'Times New Roman', serif"
      };
    }
    function footerTextPreview() {
      const footer = DRAFTS.content.footer;
      if (footer.text && footer.text.trim()) return footer.text.trim();
      const name = DRAFTS.content.seo.siteName || '';
      return ('© ' + new Date().getFullYear() + ' ' + name).trim();
    }
    function applyFooterPreview(doc) {
      const footer = doc.querySelector('footer');
      if (!footer) return;
      footer.hidden = !DRAFTS.content.footer.show;
      const text = footer.querySelector('[data-footer-text], .footer-text');
      if (text) text.textContent = footerTextPreview();
      const social = footer.querySelector('[data-footer-social], .footer-social');
      if (social) {
        const links = DRAFTS.content.footer.social.filter(s => s.label.trim() && isHttpUrl(s.url));
        social.replaceChildren(...links.map(s => el('a', { href: s.url, target: '_blank', rel: 'noopener', text: s.label })));
      }
    }
    // Optional approximation: point the preview's logo at the tint route when the logo is an SVG.
    function applyLogoTintPreview(doc) {
      const tint = DRAFTS.appearance.colors.logo;
      const tintable = BRANDING.logoIsSvg && isHexColor(tint);
      doc.querySelectorAll('header img, footer img, .logo img').forEach(img => {
        if (!img.dataset.cpOriginal) img.dataset.cpOriginal = img.getAttribute('src') || '';
        if (tintable) img.src = '/brand/logo.svg?color=' + encodeURIComponent(tint);
        else if (img.dataset.cpOriginal) img.src = img.dataset.cpOriginal;
        else img.removeAttribute('src');
      });
    }
    function applyPreview() {
      const doc = previewDoc();
      if (!doc || !doc.documentElement || !doc.body) return;
      const style = doc.documentElement.style;
      const vars = appearanceCssVars(DRAFTS.appearance);
      Object.keys(vars).forEach(name => style.setProperty(name, vars[name]));
      const header = doc.querySelector('header');
      if (header) header.dataset.layout = DRAFTS.appearance.header.layout;
      applyLogoTintPreview(doc);
      applyFooterPreview(doc);
    }
    function refreshPreview() {
      previewFrame.src = '/portfolio?preview=' + Date.now();
    }
    previewFrame.addEventListener('load', applyPreview);
    document.getElementById('previewRefresh').addEventListener('click', refreshPreview);
    document.querySelectorAll('[data-preview-width]').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-preview-width]').forEach(b => b.classList.toggle('active', b === btn));
        const mobile = btn.dataset.previewWidth === 'mobile';
        previewWrap.classList.toggle('mobile', mobile);
        previewWrap.classList.toggle('desktop', !mobile);
      });
    });
    document.addEventListener('tabchange', e => { if (e.detail && e.detail.tab === 'settings') applyPreview(); });

    // ---- Footer social links (max 4 rows) ----
    const socialRows = document.getElementById('socialRows');
    const addSocialBtn = document.getElementById('addSocial');
    function socialRow(entry) {
      const labelInput = el('input', { type: 'text', class: 'social-label', placeholder: 'Label (e.g. Instagram)', 'aria-label': 'Social link label' });
      const urlInput = el('input', { type: 'url', placeholder: 'https://…', 'aria-label': 'Social link URL' });
      labelInput.value = entry.label || '';
      urlInput.value = entry.url || '';
      labelInput.addEventListener('input', () => { entry.label = labelInput.value; settingsTouched(); });
      urlInput.addEventListener('input', () => { entry.url = urlInput.value; settingsTouched(); });
      const remove = mini('Remove', 'Remove this social link', () => {
        const at = DRAFTS.content.footer.social.indexOf(entry);
        if (at !== -1) DRAFTS.content.footer.social.splice(at, 1);
        settingsTouched();
        renderSocialRows();
      }, { class: 'mini danger' });
      return el('div', { class: 'social-row' }, labelInput, urlInput, remove);
    }
    function renderSocialRows() {
      const social = DRAFTS.content.footer.social;
      socialRows.replaceChildren();
      social.forEach(entry => socialRows.append(socialRow(entry)));
      addSocialBtn.disabled = social.length >= 4;
      addSocialBtn.title = social.length >= 4 ? 'You can have up to 4 social links' : 'Add a social link';
    }
    addSocialBtn.addEventListener('click', () => {
      if (DRAFTS.content.footer.social.length >= 4) return;
      DRAFTS.content.footer.social.push({ label: '', url: '' });
      settingsTouched();
      renderSocialRows();
    });

    // ---- SEO image uploads (uploaded as-is via uploadToR2, saved by the save bar) ----
    const ogImagePreview = document.getElementById('ogImagePreview');
    const faviconPreview = document.getElementById('faviconPreview');
    function renderSeoPreviews() {
      const seo = DRAFTS.content.seo;
      ogImagePreview.replaceChildren(seo.ogImage ? el('img', { src: seo.ogImage, alt: 'OG image preview' }) : el('span', { text: 'None' }));
      faviconPreview.replaceChildren(seo.favicon ? el('img', { src: seo.favicon, alt: 'Favicon preview' }) : el('span', { text: 'None' }));
    }
    async function uploadSeoImage(kind) {
      const isOg = kind === 'og';
      const button = document.getElementById(isOg ? 'ogImageUpload' : 'faviconUpload');
      const status = document.getElementById(isOg ? 'ogImageStatus' : 'faviconStatus');
      const files = await pickFiles(false);
      if (!files.length) return;
      button.disabled = true;
      setMsg(status, 'Uploading...');
      try {
        // Upload as-is: social crawlers and browsers are picky about OG images/favicons in WebP.
        const url = await uploadToR2(files[0]);
        DRAFTS.content.seo[isOg ? 'ogImage' : 'favicon'] = url;
        settingsTouched();
        renderSeoPreviews();
        setMsg(status, 'Uploaded. Click “Save changes” to publish it.', 'ok');
        toast((isOg ? 'OG image' : 'Favicon') + ' uploaded. Save changes to publish.', 'ok');
      } catch (err) {
        setMsg(status, err.message, 'err');
        toast(err.message, 'err');
      } finally {
        button.disabled = false;
      }
    }
    document.getElementById('ogImageUpload').addEventListener('click', () => uploadSeoImage('og'));
    document.getElementById('faviconUpload').addEventListener('click', () => uploadSeoImage('favicon'));

    // ---- About page headshot upload ----
    const aboutHeadshotPreview = document.getElementById('aboutHeadshotPreview');
    function renderAboutHeadshotPreview() {
      const url = DRAFTS.content.about.headshot;
      aboutHeadshotPreview.replaceChildren(url ? el('img', { src: url, alt: 'About headshot preview' }) : el('span', { text: 'None' }));
    }
    document.getElementById('aboutHeadshotUpload').addEventListener('click', async () => {
      const button = document.getElementById('aboutHeadshotUpload');
      const status = document.getElementById('aboutHeadshotStatus');
      const files = await pickFiles(false);
      if (!files.length) return;
      button.disabled = true;
      setMsg(status, 'Uploading...');
      try {
        // Uploaded as-is: keep the photo's original format and quality.
        const url = await uploadToR2(files[0]);
        DRAFTS.content.about.headshot = url;
        settingsTouched();
        renderAboutHeadshotPreview();
        setMsg(status, 'Uploaded. Click “Save changes” to publish it.', 'ok');
        toast('Headshot uploaded. Save changes to publish.', 'ok');
      } catch (err) {
        setMsg(status, err.message, 'err');
        toast(err.message, 'err');
      } finally {
        button.disabled = false;
      }
    });

    // ---- Read-only security status (DATA.securityStatus) ----
    function renderSecurity() {
      const host = document.getElementById('securityRows');
      const status = DATA.securityStatus;
      host.replaceChildren();
      if (!status || typeof status !== 'object') {
        host.append(el('p', { class: 'hint', text: 'This server build does not report security status yet.' }));
        return;
      }
      const check = (label, ok) => el('div', { class: 'security-row' },
        el('span', { text: label }),
        el('span', { class: ok ? 'sec-ok' : 'sec-bad', text: ok ? '✓ Configured' : '✗ Not configured' }));
      host.append(
        check('Admin username', !!status.adminUserConfigured),
        check('Admin password', !!status.adminPasswordConfigured),
        check('Session secret', !!status.sessionSecretConfigured),
        el('div', { class: 'security-row' },
          el('span', { text: 'Legacy user accounts' }),
          el('span', { class: 'sec-value', text: String(Number(status.legacyUsers) || 0) }))
      );
    }

    // ---- Background color (kept independent: its own Save button, also picked up by the save bar) ----
    const bgPicker = document.getElementById('siteBgPicker');
    const bgHex = document.getElementById('siteBgHex');
    const bgPreview = document.getElementById('siteBgPreview');
    const bgStatus = document.getElementById('siteBgStatus');
    function showBg(color) {
      bgPicker.value = color;
      bgHex.value = color;
      const [r, g, b] = [1, 3, 5].map(i => parseInt(color.slice(i, i + 2), 16));
      const dark = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255 < 0.55;
      bgPreview.style.background = color;
      bgPreview.style.color = dark ? '#fff' : '#111';
    }
    function noteBg(message, kind) {
      setMsg(bgStatus, message, kind);
    }
    function applySavedBg(color) {
      BG.saved = color;
      BG.value = color;
      CONFIG.siteBg = color;
      Object.keys(S).forEach(id => { if (!S[id].bg) syncBgControls(id); });
      updateSaveBar();
    }
    showBg(BG.saved);
    bgPicker.addEventListener('input', () => {
      showBg(bgPicker.value);
      BG.value = bgPicker.value;
      noteBg('Not saved yet.');
      settingsTouched();
    });
    bgHex.addEventListener('input', () => {
      let value = bgHex.value.trim();
      if (value && value[0] !== '#') value = '#' + value;
      if (isHexColor(value)) {
        showBg(value.toLowerCase());
        BG.value = value.toLowerCase();
        noteBg('Not saved yet.');
        settingsTouched();
      }
    });
    document.getElementById('siteBgReset').addEventListener('click', () => {
      BG.value = isHexColor(CONFIG.defaultBg) ? CONFIG.defaultBg : '#181818';
      showBg(BG.value);
      noteBg('Reset to the default. Click “Save changes” to apply it.');
      settingsTouched();
    });
    document.getElementById('siteBgSave').addEventListener('click', async () => {
      const button = document.getElementById('siteBgSave');
      button.disabled = true;
      noteBg('Saving...');
      try {
        const data = await api('/api/settings', { bg_color: BG.value });
        applySavedBg(data.bg_color || BG.value);
        showBg(BG.saved);
        noteBg('Saved. Every page without its own background color now uses this one.', 'ok');
        toast('Background saved.', 'ok');
      } catch (err) {
        noteBg(err.message, 'err');
        toast(err.message, 'err');
      } finally {
        button.disabled = false;
      }
    });

    // ---- Save / discard: appearance → content → background, sequentially ----
    function socialForSave() {
      return DRAFTS.content.footer.social
        .map(row => ({ label: String(row.label || '').trim(), url: String(row.url || '').trim() }))
        .filter(row => row.label || row.url);
    }
    function validateSocial(rows) {
      for (const row of rows) {
        if (!row.label) return 'Every social link needs a label (for example "Instagram").';
        if (!isHttpUrl(row.url)) return 'The social link for "' + row.label + '" must start with http:// or https://.';
      }
      return '';
    }
    // Button URL may be a local path ("/contact") or an absolute http(s) URL.
    function validateAbout(content) {
      const url = String(content.about.buttonUrl || '').trim();
      if (url && url.charAt(0) !== '/' && !isHttpUrl(url)) {
        return 'The About button URL must start with "/" or with http:// / https://.';
      }
      return '';
    }
    async function saveSettings() {
      const saveBtn = document.getElementById('settingsSave');
      saveBtn.disabled = true;
      // Clamp one last time so what is posted is exactly what the contract allows.
      DRAFTS.appearance = sanitizeAppearance(DRAFTS.appearance);
      DRAFTS.content = sanitizeContent(DRAFTS.content);
      syncAppearanceControls();
      syncContentControls();
      let savedAnything = false;
      try {
        if (JSON.stringify(DRAFTS.appearance) !== JSON.stringify(SAVED.appearance)) {
          const data = await api('/api/settings/appearance', { appearance: DRAFTS.appearance });
          DRAFTS.appearance = sanitizeAppearance(data.appearance || DRAFTS.appearance);
          SAVED.appearance = clone(DRAFTS.appearance);
          syncAppearanceControls();
          savedAnything = true;
        }
        if (JSON.stringify(DRAFTS.content) !== JSON.stringify(SAVED.content)) {
          const content = clone(DRAFTS.content);
          content.footer.social = socialForSave();
          content.about.buttonUrl = content.about.buttonUrl.trim();
          const problem = validateSocial(content.footer.social) || validateAbout(content);
          if (problem) throw new Error(problem);
          const data = await api('/api/settings/content', { content });
          DRAFTS.content = sanitizeContent(data.content || content);
          SAVED.content = clone(DRAFTS.content);
          syncContentControls();
          savedAnything = true;
        }
        if (BG.value !== BG.saved) {
          const data = await api('/api/settings', { bg_color: BG.value });
          applySavedBg(data.bg_color || BG.value);
          showBg(BG.saved);
          noteBg('Background saved.', 'ok');
          savedAnything = true;
        }
      } catch (err) {
        updateSaveBar();
        toast(err.message, 'err');
        return;
      } finally {
        saveBtn.disabled = false;
        updateSaveBar();
      }
      updateSaveBar();
      applyPreview();
      refreshPreview();
      toast(savedAnything ? 'Settings saved. Your site is updated.' : 'Nothing to save yet.', savedAnything ? 'ok' : '', savedAnything ? 4000 : 2000);
    }
    function discardSettings() {
      if (!hasSettingsChanges()) return;
      if (!confirm('Discard all unsaved settings changes?')) return;
      DRAFTS.appearance = clone(SAVED.appearance);
      DRAFTS.content = clone(SAVED.content);
      BG.value = BG.saved;
      syncAppearanceControls();
      syncContentControls();
      showBg(BG.saved);
      noteBg('');
      updateSaveBar();
      applyPreview();
      toast('Unsaved settings changes discarded.', 'ok', 2500);
    }
    document.getElementById('settingsSave').addEventListener('click', saveSettings);
    document.getElementById('settingsDiscard').addEventListener('click', discardSettings);

    // ---- Initial paint from the server-provided (or default) objects ----
    syncAppearanceControls();
    syncContentControls();
    renderSecurity();
    updateSaveBar();
    if (previewDoc() && previewFrame.contentDocument.readyState === 'complete') applyPreview();
  </script>
</body>
</html>