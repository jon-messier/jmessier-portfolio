<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin | Manage Projects</title>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; }
    body { font-family: 'Open Sans', sans-serif; background: #111; color: #fff; margin: 0; padding: 2rem; }
    .container { max-width: 1200px; margin: 0 auto; }
    h1, h2, h3 { font-weight: 600; margin-top: 0; }
    a { color: #8fa2ff; }
    .top-nav { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 1rem; }
    .top-nav h1 { margin: 0; font-size: 1.5rem; }
    .top-nav-actions { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
    .top-nav-actions form { margin: 0; }
    .card { background: #222; padding: 1.5rem; border-radius: 8px; margin-bottom: 1.5rem; border: 1px solid #333; }
    .form-group { margin-bottom: 1rem; }
    label { display: block; font-size: 0.85rem; color: #aaa; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 1px; }
    input[type="text"], input[type="email"], input[type="url"], input[type="search"], input[type="number"], textarea, input[type="file"], select.input, select.field { width: 100%; padding: 10px; background: #111; border: 1px solid #444; color: #fff; border-radius: 4px; font-family: 'Open Sans', sans-serif; }
    .btn { background: #4361ee; color: #fff; border: none; padding: 10px 16px; border-radius: 4px; cursor: pointer; font-weight: 600; font-size: 0.9rem; text-decoration: none; display: inline-block; font-family: inherit; }
    .btn:hover { background: #3049c4; }
    .btn:disabled { background: #555; cursor: not-allowed; }
    .btn-sm { padding: 6px 12px; font-size: 0.8rem; }
    .btn-danger { background: #e63946; }
    .btn-danger:hover { background: #ba2d39; }
    .btn-outline { background: transparent; border: 1px solid #555; color: #aaa; }
    .btn-outline:hover { background: #333; color: #fff; }
    .status-msg { font-size: 0.9rem; margin-top: 1rem; color: #8fa2ff; }
    .status-msg:empty { display: none; }
    .status-msg.err { color: #ff6b76; }
    .status-msg.ok { color: #52b788; }
    .hint { font-size: 0.8rem; color: #777; margin: -0.25rem 0 0.75rem; text-transform: none; letter-spacing: 0; }

    /* Tabs */
    .tabs { display: flex; gap: 0.25rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; }
    .tab-btn { background: none; border: none; border-bottom: 2px solid transparent; color: #aaa; padding: 0.6rem 1rem; font: inherit; font-weight: 600; cursor: pointer; margin-bottom: -1px; }
    .tab-btn:hover { color: #fff; }
    .tab-btn.active { color: #fff; border-bottom-color: #4361ee; }
    .badge { display: inline-block; min-width: 1.4em; padding: 0 0.4em; border-radius: 10px; background: #e63946; color: #fff; font-size: 0.75rem; text-align: center; margin-left: 0.3rem; }
    .badge:empty { display: none; }

    /* New project drop zone */
    .drop-zone { border: 2px dashed #444; border-radius: 8px; padding: 1.75rem 1rem; text-align: center; color: #aaa; cursor: pointer; transition: border-color 0.15s, background 0.15s; }
    .drop-zone:hover, .drop-zone.file-over { border-color: #4361ee; background: rgba(67, 97, 238, 0.12); color: #fff; }
    .drop-zone strong { color: #fff; }
    .drop-list { font-size: 0.85rem; color: #ddd; margin-top: 0.5rem; }

    /* Project list */
    .list-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
    .project-item.drop-before { box-shadow: 0 -3px 0 #4361ee; }
    .project-item.drop-after { box-shadow: 0 3px 0 #4361ee; }
    .project-row { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; background: #1a1a1a; border: 1px solid #333; border-radius: 6px; margin-bottom: 1rem; }
    .project-item.is-hidden .project-row { opacity: 0.6; }
    .project-item.is-hidden .project-row:hover { opacity: 1; }
    .project-info { display: flex; align-items: center; gap: 1rem; min-width: 0; flex: 1; }
    .project-info img { width: 80px; height: 60px; object-fit: cover; border-radius: 4px; background: #111; flex-shrink: 0; }
    .project-info h3 { margin: 0; font-size: 1.05rem; }
    .row-meta { font-size: 0.8rem; color: #888; display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
    .row-link { color: #8fa2ff; text-decoration: none; word-break: break-all; }
    .row-link:hover { text-decoration: underline; }
    .pill { font-size: 0.7rem; font-weight: 700; padding: 1px 8px; border-radius: 10px; text-transform: uppercase; letter-spacing: 0.5px; }
    .pill-hidden { background: #444; color: #ddd; }
    .project-item:not(.is-hidden) .pill-hidden { display: none; }
    .row-note { font-size: 0.8rem; }
    .row-note.ok { color: #52b788; }
    .row-note.warn { color: #ffd166; }
    .row-actions { display: flex; gap: 0.4rem; align-items: center; flex-shrink: 0; }
    .row-actions form { margin: 0; }
    .handle { cursor: grab; font-size: 1.2rem; color: #777; padding: 0 0.3rem; user-select: none; line-height: 1; }
    .handle:hover { color: #fff; }

    /* Edit panel */
    .edit-panel { display: none; background: #1a1a1a; padding: 1.5rem; border-radius: 6px; border: 1px solid #4361ee; margin: -0.5rem 0 2rem; }
    .edit-panel.active { display: block; }
    .panel-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    .panel-head h3 { margin: 0; font-size: 1rem; color: #aaa; }
    .cover-row { display: flex; gap: 1rem; align-items: center; }
    .cover-row img { width: 120px; height: 90px; object-fit: cover; border-radius: 4px; background: #111; flex-shrink: 0; }
    .settings-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 1rem; }
    .settings-row select { width: 100%; padding: 8px; background: #111; border: 1px solid #444; color: #fff; border-radius: 4px; font-family: inherit; }
    .bg-control { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .bg-control input[type="color"] { width: 44px; height: 34px; padding: 2px; background: #111; border: 1px solid #444; border-radius: 4px; cursor: pointer; }
    .bg-control input[type="color"]:disabled { opacity: 0.35; cursor: not-allowed; }
    .inline-check { display: inline-flex; align-items: center; gap: 0.4rem; text-transform: none; letter-spacing: 0; color: #ddd; margin: 0; font-size: 0.85rem; cursor: pointer; }

    /* Layout editor */
    .layout-editor { display: flex; flex-direction: column; border-radius: 6px; }
    .layout-editor.busy { opacity: 0.6; pointer-events: none; }
    .layout-editor.file-over { outline: 2px dashed #4361ee; outline-offset: 4px; }
    .layout-empty { color: #777; font-size: 0.9rem; padding: 1.5rem; text-align: center; border: 1px dashed #444; border-radius: 6px; }
    .blk { background: #111; border: 1px solid #333; border-radius: 6px; padding: 0.75rem; }
    .blk.file-over { border-color: #4361ee; background: rgba(67, 97, 238, 0.12); }
    .blk-head { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.6rem; font-size: 0.85rem; color: #aaa; }
    .blk-label { font-weight: 600; color: #ddd; }
    .grow { flex: 1; }
    .mini { background: #2a2a2a; color: #ddd; border: 1px solid #444; border-radius: 4px; padding: 4px 9px; font-size: 0.8rem; cursor: pointer; font-family: inherit; text-decoration: none; display: inline-block; }
    .mini:hover { background: #3a3a3a; }
    .mini:disabled { opacity: 0.35; cursor: default; }
    .mini.danger:hover { background: #e63946; border-color: #e63946; color: #fff; }
    .blk-head input[type="number"], .blk-head select { padding: 4px; background: #1a1a1a; border: 1px solid #444; color: #fff; border-radius: 4px; font-family: inherit; font-size: 0.8rem; }
    .blk-head input[type="number"] { width: 3.2rem; }
    .grid-edit { display: grid; gap: 0.5rem; }
    .tile { position: relative; height: 110px; background: #1d1d1d; border-radius: 4px; overflow: hidden; border: 2px solid transparent; }
    .tile.wide { height: 150px; }
    .tile img { width: 100%; height: 100%; object-fit: cover; display: block; cursor: grab; }
    .tile.wide img { object-fit: contain; background: #000; }
    .tile.over { border-color: #4361ee; }
    .tile.empty { border: 2px dashed #444; display: flex; align-items: center; justify-content: center; }
    .tile.empty.over { border-color: #4361ee; background: rgba(67, 97, 238, 0.15); }
    .tile-bar { position: absolute; top: 4px; right: 4px; display: flex; gap: 3px; opacity: 0; transition: opacity 0.15s; }
    .tile:hover .tile-bar, .tile:focus-within .tile-bar { opacity: 1; }
    @media (hover: none) { .tile-bar { opacity: 1; } }
    .tile-bar button { background: rgba(0, 0, 0, 0.8); color: #fff; border: none; border-radius: 3px; width: 28px; height: 28px; cursor: pointer; font-size: 0.85rem; }
    .tile-bar button:hover { background: #4361ee; }
    .tile-bar button:disabled { opacity: 0.3; cursor: default; background: rgba(0, 0, 0, 0.8); }
    .tile-bar button.on { color: #ffd166; }
    .cover-badge { position: absolute; left: 4px; top: 4px; background: #ffd166; color: #000; font-size: 0.65rem; font-weight: 700; padding: 2px 6px; border-radius: 3px; text-transform: uppercase; letter-spacing: 0.5px; }
    .missing { display: none; position: absolute; inset: 0; align-items: center; justify-content: center; text-align: center; padding: 0.5rem; font-size: 0.8rem; color: #ff8a93; background: #1a1010; }
    .tile.broken .missing { display: flex; }
    .tile.broken img { visibility: hidden; }
    .embed-code { width: 100%; font-family: monospace; font-size: 0.8rem; }
    .dz { height: 10px; margin: 2px 0; border-radius: 4px; transition: height 0.1s, background 0.1s; }
    body.dragging .dz, body.dragging-files .dz { height: 26px; background: rgba(67, 97, 238, 0.08); border: 1px dashed rgba(67, 97, 238, 0.5); }
    .dz.over, .dz.file-over { background: rgba(67, 97, 238, 0.45) !important; }
    .editor-tools { display: flex; gap: 0.5rem; flex-wrap: wrap; margin: 1rem 0 1.5rem; }
    .editor-actions { display: flex; gap: 0.5rem; align-items: center; border-top: 1px solid #333; padding: 0.85rem 0 0.25rem; position: sticky; bottom: 0; z-index: 5; background: #1a1a1a; margin-top: 1rem; }

    /* Inbox */
    .inbox-empty { color: #777; text-align: center; padding: 2rem; }
    .msg { border: 1px solid #333; border-radius: 6px; margin-bottom: 0.5rem; background: #1a1a1a; }
    .msg-head { display: grid; grid-template-columns: 12px 160px 1fr auto; gap: 0.75rem; align-items: center; width: 100%; background: none; border: none; color: #aaa; font: inherit; font-size: 0.9rem; text-align: left; padding: 0.75rem 1rem; cursor: pointer; }
    .msg-head:hover { background: #222; }
    .dot { width: 8px; height: 8px; border-radius: 50%; background: transparent; }
    .msg.unread .dot { background: #4361ee; }
    .msg.unread .msg-from { color: #fff; font-weight: 700; }
    .msg-from { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .msg-preview { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #888; }
    .msg-date { font-size: 0.8rem; color: #777; white-space: nowrap; }
    .msg-body { padding: 0 1rem 1rem 2.6rem; }
    .msg-email { font-size: 0.85rem; margin-bottom: 0.75rem; }
    .msg-text { white-space: pre-wrap; margin: 0 0 1rem; color: #ddd; line-height: 1.6; }
    .msg-actions { display: flex; gap: 0.5rem; }
    @media (max-width: 640px) { .msg-head { grid-template-columns: 12px 1fr auto; } .msg-preview { display: none; } }

    /* Site settings */
    .bg-settings { display: flex; gap: 1.5rem; align-items: center; flex-wrap: wrap; }
    .bg-settings input[type="color"] { width: 64px; height: 44px; padding: 2px; background: #111; border: 1px solid #444; border-radius: 4px; cursor: pointer; }
    .bg-settings input[type="text"] { width: 110px; font-family: monospace; }
    .bg-preview { flex: 1; min-width: 220px; padding: 1rem 1.25rem; border-radius: 6px; border: 1px solid #333; }
    .bg-preview strong { display: block; }
    .bg-preview span { font-size: 0.85rem; opacity: 0.6; }
    .current-logo { max-height: 40px; max-width: 100px; filter: brightness(0) invert(1); }

    /* Admin UX: toasts, filters, settings cards, preview, save bar */
    .toast-stack { position: fixed; top: 1rem; right: 1rem; z-index: 1000; display: flex; flex-direction: column; gap: 0.5rem; max-width: 340px; }
    .toast { background: #1e1e1e; border: 1px solid #444; border-left: 4px solid #4361ee; color: #fff; padding: 0.7rem 1rem; border-radius: 6px; font-size: 0.9rem; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45); cursor: pointer; animation: toast-in 0.15s ease-out; }
    .toast.ok { border-left-color: #52b788; }
    .toast.err { border-left-color: #e63946; }
    .toast.leaving { opacity: 0; transform: translateY(-4px); transition: opacity 0.2s, transform 0.2s; }
    @keyframes toast-in { from { opacity: 0; transform: translateY(-6px); } }

    .list-filters { display: flex; align-items: center; gap: 1rem; margin: 0 0 1rem; flex-wrap: wrap; }
    .list-filters input[type="search"] { max-width: 320px; }

    .tab-intro { color: #aaa; font-size: 0.9rem; margin: -0.5rem 0 1.5rem; }
    .card-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
    .card-head h2 { margin: 0 0 0.25rem; }
    .field-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 1rem; margin-bottom: 1rem; }
    .field label { margin-bottom: 0.35rem; }
    .field select { width: 100%; padding: 10px; background: #111; border: 1px solid #444; color: #fff; border-radius: 4px; font-family: 'Open Sans', sans-serif; }
    .check-row { margin: 0 0 1rem; }

    .social-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 0.6rem; }
    .social-head label { margin: 0; }
    .social-rows { display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 0.75rem; }
    .social-row { display: flex; gap: 0.5rem; align-items: center; }
    .social-row input { flex: 1 1 160px; }
    .social-row input.social-label { flex: 0 1 180px; }

    .upload-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; }
    .upload-row { display: flex; gap: 1rem; align-items: flex-start; }
    .upload-thumb { width: 120px; height: 68px; background: #111; border: 1px dashed #444; border-radius: 4px; display: flex; align-items: center; justify-content: center; overflow: hidden; color: #777; font-size: 0.8rem; flex-shrink: 0; }
    .upload-thumb.small { width: 48px; height: 48px; }
    .upload-thumb img { width: 100%; height: 100%; object-fit: contain; background: #000; }
    .upload-thumb.small img { object-fit: cover; }
    .upload-item .hint { margin: 0.25rem 0 0; }

    .preview-shell { background: #0a0a0a; border: 1px solid #333; border-radius: 6px; padding: 0.75rem; display: flex; justify-content: center; }
    .preview-frame-wrap { width: 100%; transition: width 0.2s; }
    .preview-frame-wrap.mobile { width: 390px; max-width: 100%; }
    .preview-frame-wrap iframe { width: 100%; height: 540px; border: 0; border-radius: 4px; background: #181818; display: block; }
    .preview-frame-wrap.mobile iframe { height: 620px; }
    .preview-actions { display: flex; gap: 0.4rem; flex-wrap: wrap; }
    .preview-actions .mini.active { background: #4361ee; border-color: #4361ee; color: #fff; }

    .save-bar { position: sticky; bottom: 0; z-index: 20; display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; background: #1a1a1a; border: 1px solid #333; border-radius: 8px; padding: 0.85rem 1.25rem; margin: 0.25rem 0 0; box-shadow: 0 -6px 20px rgba(0, 0, 0, 0.35); }
    .save-actions { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
    .save-note { font-size: 0.85rem; color: #777; }
    .save-note.dirty { color: #ffd166; font-weight: 600; }
    .save-note.dirty::before { content: '● '; }

    .security-rows { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 0.75rem; }
    .security-row { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.9rem; border-bottom: 1px solid #2a2a2a; padding-bottom: 0.4rem; }
    .security-row:last-child { border-bottom: none; }
    .sec-ok { color: #52b788; font-weight: 700; }
    .sec-bad { color: #ff6b76; font-weight: 700; }
    .sec-value { color: #ddd; }

    /* Color picker (Photoshop-style): native color inputs are hidden and replaced by a swatch */
    .cp-native { position: absolute !important; width: 1px !important; height: 1px !important; opacity: 0 !important; pointer-events: none !important; }
    .cp-attach { display: inline-flex; align-items: center; gap: 0.5rem; }
    .cp-swatch { width: 44px; height: 34px; padding: 0; border: 1px solid #555; border-radius: 4px; cursor: pointer; background: #000; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.35); }
    .cp-swatch:hover { border-color: #8fa2ff; }
    .cp-swatch:disabled, .cp-swatch.cp-disabled { opacity: 0.35; cursor: not-allowed; }
    .cp-hexlabel { font-family: monospace; font-size: 0.8rem; color: #bbb; }

    .cp-pop { position: fixed; z-index: 2000; width: 258px; padding: 0.7rem; background: #1b1b1b; border: 1px solid #444; border-radius: 8px; box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6); color: #ddd; font-family: 'Open Sans', sans-serif; font-size: 0.8rem; user-select: none; outline: none; }
    .cp-pop-head { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; margin-bottom: 0.5rem; font-weight: 600; color: #fff; }
    .cp-pop-head code { color: #9fb0ff; font-size: 0.75rem; font-family: monospace; }
    .cp-body { display: flex; gap: 0.6rem; }
    .cp-sv { position: relative; flex: 1; height: 150px; border-radius: 4px; cursor: crosshair; touch-action: none; }
    .cp-sv-white, .cp-sv-black { position: absolute; inset: 0; pointer-events: none; border-radius: 4px; }
    .cp-sv-white { background: linear-gradient(to right, #fff, rgba(255, 255, 255, 0)); }
    .cp-sv-black { background: linear-gradient(to top, #000, rgba(0, 0, 0, 0)); }
    .cp-sv-handle { position: absolute; width: 12px; height: 12px; border: 2px solid #fff; border-radius: 50%; box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.7); transform: translate(-50%, -50%); pointer-events: none; }
    .cp-hue { position: relative; width: 16px; height: 150px; border-radius: 8px; cursor: ns-resize; touch-action: none; background: linear-gradient(to bottom, #ff0000, #ffff00 16.66%, #00ff00 33.33%, #00ffff 50%, #0000ff 66.66%, #ff00ff 83.33%, #ff0000); }
    .cp-hue-handle { position: absolute; left: -3px; right: -3px; height: 6px; border: 2px solid #fff; border-radius: 4px; box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.7); transform: translateY(-50%); pointer-events: none; }
    .cp-swatches { display: flex; gap: 0.6rem; margin: 0.6rem 0; }
    .cp-swatch-box { flex: 1; }
    .cp-swatch-box span { display: block; margin-bottom: 2px; font-size: 0.65rem; color: #888; text-transform: uppercase; letter-spacing: 0.5px; }
    .cp-swatch-color { height: 24px; border: 1px solid #444; border-radius: 4px; cursor: pointer; }
    .cp-fields { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.4rem; margin-bottom: 0.45rem; }
    .cp-fields label, .cp-hex-row label { display: block; margin-bottom: 2px; font-size: 0.65rem; color: #999; text-transform: uppercase; letter-spacing: 0.5px; }
    .cp-fields input, .cp-hex-row input { width: 100%; padding: 4px 5px; background: #111; border: 1px solid #444; color: #fff; border-radius: 3px; font-family: monospace; font-size: 0.8rem; }
    .cp-hex-row { display: flex; align-items: center; gap: 0.45rem; margin-bottom: 0.6rem; }
    .cp-hex-row label { margin: 0; white-space: nowrap; }
    .cp-actions { display: flex; justify-content: flex-end; gap: 0.4rem; }
    .cp-actions .mini.ok { background: #4361ee; border-color: #4361ee; color: #fff; }

    /* Colors card tint rows */
    .tint-grid { display: grid; gap: 0.8rem; }
    .tint-row { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
    .tint-row .hint { flex: 1 1 220px; margin: 0; }
    .upload-thumb.portrait { width: 84px; height: 104px; }

    @media (max-width: 700px) {
      body { padding: 1rem; }
      .settings-row { grid-template-columns: 1fr; }
      .project-row { flex-wrap: wrap; }
      .row-actions { width: 100%; justify-content: flex-end; flex-wrap: wrap; }
      .top-nav { align-items: flex-start; }
      .toast-stack { left: 1rem; right: 1rem; max-width: none; }
      .save-bar { flex-direction: column; align-items: stretch; }
      .save-actions { justify-content: flex-end; }
      .preview-frame-wrap.mobile { width: 100%; }
      .preview-frame-wrap iframe { height: 460px; }
      .social-row { flex-wrap: wrap; }
      .social-row input { flex: 1 1 100%; }
      .upload-row { flex-direction: column; }
      .field-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="top-nav">
      <h1>Admin Dashboard</h1>
      <div class="top-nav-actions">
        <a href="/" class="btn btn-outline" target="_blank" rel="noopener">View Site &rarr;</a>
        <a href="/admin/backup.json" class="btn btn-outline" title="Download a JSON backup of your projects and settings">Backup</a>
        <form action="/logout" method="POST"><button type="submit" class="btn btn-outline">Log out</button></form>
      </div>
    </div>

    <div class="tabs">
      <button type="button" class="tab-btn" data-tab="projects">Projects</button>
      <button type="button" class="tab-btn" data-tab="inbox">Inbox<span class="badge" id="unreadBadge"></span></button>
      <button type="button" class="tab-btn" data-tab="settings">Site Settings</button>
    </div>

    <!-- ===================== PROJECTS TAB ===================== -->
    <section class="tab-panel" id="tab-projects">
      <div class="card">
        <h2>Add New Project</h2>
        <form id="addForm">
          <div class="form-group"><label for="addTitle">Project Title</label><input type="text" id="addTitle" required></div>
          <div class="form-group">
            <label>Images</label>
            <div class="drop-zone" id="addDrop" tabindex="0">
              <strong>Drag images here</strong> or click to choose. The first image becomes the cover.
              <div class="drop-list" id="addList"></div>
            </div>
            <input type="file" id="addImages" multiple accept="image/*" hidden>
          </div>
          <button type="submit" class="btn" id="addBtn">Create Project</button>
          <p id="addStatus" class="status-msg"></p>
        </form>
      </div>

      <div class="list-head">
        <h2>Existing Projects</h2>
        <span class="status-msg" id="orderStatus" style="margin:0;"></span>
      </div>
      <p class="hint" style="margin-top:-0.5rem;">Drag ⠿ or use the arrows to set the order projects appear on your Portfolio page. Hidden projects stay here but don't appear on the live site.</p>

      <div class="list-filters">
        <input type="search" id="projectSearch" placeholder="Search by title or project link…" aria-label="Search projects">
        <label class="inline-check"><input type="checkbox" id="hiddenOnly"> Hidden only</label>
      </div>
      <p class="hint" id="noProjectMatch" hidden>No projects match your search.</p>

      <div id="projectList">
      <% projects.forEach(function(project) { %>
        <div class="project-item <%= project.hidden ? 'is-hidden' : '' %>" data-id="<%= project.id %>">
          <div class="project-row">
            <span class="handle row-handle" draggable="true" title="Drag to reorder">⠿</span>
            <div class="project-info">
              <img class="row-thumb" src="<%= project.cover_image %>" alt="">
              <div style="min-width:0;">
                <h3 class="row-title"><%= project.title %></h3>
                <div class="row-meta">
                  <a class="row-link" href="/project/<%= project.slug %>" target="_blank">/project/<%= project.slug %></a>
                  <span class="pill pill-hidden">Hidden</span>
                  <span class="row-note"></span>
                </div>
              </div>
            </div>
            <div class="row-actions">
              <button type="button" class="mini f-up" title="Move up">↑</button>
              <button type="button" class="mini f-down" title="Move down">↓</button>
              <button type="button" class="btn btn-sm btn-outline f-visibility"><%= project.hidden ? 'Show' : 'Hide' %></button>
              <button type="button" class="btn btn-sm f-edit">Edit</button>
              <button type="button" class="btn btn-sm btn-outline f-duplicate" title="Make a copy of this project">Duplicate</button>
              <form action="/admin/delete/<%= project.id %>" method="POST" onsubmit="return confirm('Delete this project? This can\'t be undone. To keep it but take it off the site, use Hide instead.');"><button type="submit" class="btn btn-danger btn-sm">Delete</button></form>
            </div>
          </div>

          <div class="edit-panel" id="edit-<%= project.id %>" data-id="<%= project.id %>">
            <div class="panel-head">
              <h3>Editing project</h3>
              <button type="button" class="mini f-collapse" title="Hide this editor. Unsaved changes are kept until you leave the page.">Collapse ▲</button>
            </div>
            <div class="form-group"><label>Title</label><input type="text" class="f-title"></div>
            <div class="form-group"><label>Description</label><textarea class="f-desc" rows="3"></textarea></div>

            <div class="form-group">
              <label>Cover Image</label>
              <p class="hint">Shown on the Portfolio page. Click ★ on any image below to use it, or upload a different one.</p>
              <div class="cover-row">
                <img class="f-cover-preview" alt="">
                <button type="button" class="mini f-cover-upload">Upload a different cover…</button>
              </div>
            </div>

            <div class="settings-row">
              <div>
                <label>Page Width</label>
                <select class="f-width" title="How much of the page this project's images take up"></select>
              </div>
              <div>
                <label>Space Between Images</label>
                <select class="f-gap"></select>
              </div>
              <div>
                <label>Background</label>
                <div class="bg-control">
                  <label class="inline-check"><input type="checkbox" class="f-bg-default"> Site default</label>
                  <input type="color" class="f-bg" title="This project's background color">
                </div>
              </div>
            </div>

            <div class="form-group" style="margin-bottom:0;">
              <label>Layout</label>
              <p class="hint">Drag images by the picture and blocks by ⠿. Drop an image on another image to swap, into a grid slot, or onto a blue bar to make it its own row. You can also drag image files from your computer right into the layout or into a grid. Nothing is saved until you click Save.</p>
            </div>
            <div class="layout-editor" id="layout-<%= project.id %>"></div>

            <div class="editor-tools">
              <button type="button" class="mini f-add-images">+ Add images</button>
              <button type="button" class="mini f-add-grid">+ Add grid</button>
              <button type="button" class="mini f-add-embed">+ Add embed (FlipSnack/YouTube)</button>
            </div>

            <div class="editor-actions">
              <button type="button" class="btn f-save">Save Changes</button>
              <button type="button" class="btn btn-outline f-cancel">Cancel</button>
            </div>
            <p class="status-msg" id="status-<%= project.id %>"></p>
          </div>
        </div>
      <% }); %>
      </div>
    </section>

    <!-- ===================== INBOX TAB ===================== -->
    <section class="tab-panel" id="tab-inbox" hidden>
      <div class="card">
        <h2>Inbox</h2>
        <p class="hint">Messages sent through your site's Contact page. Click one to read it.</p>
        <div id="inboxList"></div>
        <p class="status-msg" id="inboxStatus"></p>
      </div>
    </section>

    <!-- ===================== SITE SETTINGS TAB ===================== -->
    <section class="tab-panel" id="tab-settings" hidden>
      <p class="tab-intro">Design and content for your public site. Changes stay a draft until you click <strong>Save changes</strong> at the bottom of this tab.</p>

      <div class="card">
        <h2>Header &amp; branding</h2>
        <p class="hint">The top bar shown on every page, plus your site logo.</p>
        <div class="field-grid">
          <div class="field">
            <label for="setHeaderLayout">Header layout</label>
            <select id="setHeaderLayout" data-draft="appearance" data-path="header.layout">
              <option value="nav-left">Nav left (default)</option>
              <option value="logo-left">Logo left</option>
            </select>
          </div>
          <div class="field">
            <label for="setLogoHeight">Logo height (px)</label>
            <input type="number" id="setLogoHeight" min="24" max="72" step="1" data-draft="appearance" data-path="header.logoHeight" data-kind="number">
          </div>
          <div class="field">
            <label for="setHeaderPadY">Header padding, top/bottom (rem)</label>
            <input type="number" id="setHeaderPadY" min="0.75" max="2.5" step="0.25" data-draft="appearance" data-path="header.paddingY" data-kind="number">
          </div>
          <div class="field">
            <label for="setHeaderPadX">Header padding, left/right (rem)</label>
            <input type="number" id="setHeaderPadX" min="1" max="5" step="0.25" data-draft="appearance" data-path="header.paddingX" data-kind="number">
          </div>
        </div>
        <label class="inline-check check-row"><input type="checkbox" id="setHeaderSticky" data-draft="appearance" data-path="header.sticky" data-kind="bool"> Sticky header (stays at the top while scrolling)</label>

        <div style="margin-top:1.25rem; padding-top:1.25rem; border-top:1px solid #333;">
          <h3 style="font-size:0.95rem;">Site logo</h3>
          <p class="hint">A new logo saves immediately, separately from the other settings on this tab.</p>
          <% const adminLogoUrl = (locals.branding && locals.branding.logoUrl) || locals.logoUrl || ''; %>
          <div class="form-group" style="display:flex; align-items:center; gap:2rem; margin:0;">
            <div style="flex:1;">
              <label for="logoInput">Site Logo (SVG/PNG)</label>
              <input type="file" id="logoInput" accept="image/*">
              <p id="logoStatus" class="status-msg"></p>
            </div>
            <div style="background:#000; padding:1rem; border-radius:8px; min-width:150px; text-align:center;">
              <span style="font-size:0.8rem; color:#aaa; display:block; margin-bottom:0.5rem;">Current:</span>
              <% if (adminLogoUrl) { %><img src="<%= adminLogoUrl %>" alt="Current logo" class="current-logo"><% } else { %><span style="font-size:1.5rem; font-weight:700;">JM</span><% } %>
            </div>
          </div>
        </div>
      </div>

      <div class="card">
        <h2>Portfolio grid</h2>
        <p class="hint">How the project grid looks on your Portfolio page.</p>
        <div class="field-grid">
          <div class="field">
            <label for="setHomeColumns">Columns (desktop)</label>
            <input type="number" id="setHomeColumns" min="1" max="4" step="1" data-draft="appearance" data-path="home.columns" data-kind="number">
          </div>
          <div class="field">
            <label for="setHomeColumnsMobile">Columns (mobile, up to 900px)</label>
            <input type="number" id="setHomeColumnsMobile" min="1" max="2" step="1" data-draft="appearance" data-path="home.columnsMobile" data-kind="number">
          </div>
          <div class="field">
            <label for="setHomeMax">Page width</label>
            <select id="setHomeMax" data-draft="appearance" data-path="home.maxWidth" data-kind="number">
              <option value="-1">80% of screen (new default)</option>
              <option value="0">Full width</option>
              <option value="860">Narrow (860px)</option>
              <option value="1100">Standard (1100px)</option>
              <option value="1300">Wide (1300px)</option>
              <option value="1500">Extra-wide (1500px)</option>
            </select>
          </div>
          <div class="field">
            <label for="setHomeGapX">Column gap (rem)</label>
            <input type="number" id="setHomeGapX" min="0" max="4" step="0.5" data-draft="appearance" data-path="home.gapX" data-kind="number">
          </div>
          <div class="field">
            <label for="setHomeGapY">Row gap (rem)</label>
            <input type="number" id="setHomeGapY" min="1" max="6" step="0.5" data-draft="appearance" data-path="home.gapY" data-kind="number">
          </div>
          <div class="field">
            <label for="setHomeCoverRatio">Cover shape</label>
            <select id="setHomeCoverRatio" data-draft="appearance" data-path="home.coverRatio">
              <option value="4/3">4 : 3</option>
              <option value="3/2">3 : 2</option>
              <option value="16/9">16 : 9</option>
              <option value="1/1">Square (1 : 1)</option>
              <option value="natural">Natural (image's own shape)</option>
            </select>
          </div>
          <div class="field">
            <label for="setHomeCoverFit">Cover fit</label>
            <select id="setHomeCoverFit" data-draft="appearance" data-path="home.coverFit">
              <option value="cover">Cover (fill the frame)</option>
              <option value="contain">Contain (fit inside)</option>
            </select>
          </div>
          <div class="field">
            <label for="setHomeTitleSize">Project title size (rem)</label>
            <input type="number" id="setHomeTitleSize" min="0.8" max="1.6" step="0.05" data-draft="appearance" data-path="home.titleSize" data-kind="number">
          </div>
          <div class="field">
            <label for="setHomeTitleWeight">Project title weight</label>
            <select id="setHomeTitleWeight" data-draft="appearance" data-path="home.titleWeight" data-kind="number">
              <option value="400">Regular (400)</option>
              <option value="600">Semibold (600)</option>
              <option value="700">Bold (700)</option>
            </select>
          </div>
        </div>
        <label class="inline-check check-row"><input type="checkbox" id="setHomeShowTitles" data-draft="appearance" data-path="home.showTitles" data-kind="bool"> Show project titles on the portfolio page</label>
      </div>

      <div class="card">
        <div class="card-head">
          <div>
            <h2>Live preview</h2>
            <p class="hint" style="margin:0;">Your Portfolio page with the unsaved settings above applied. Nothing is saved from this preview.</p>
          </div>
          <div class="preview-actions">
            <button type="button" class="mini active" data-preview-width="desktop">Desktop</button>
            <button type="button" class="mini" data-preview-width="mobile">Mobile</button>
            <button type="button" class="mini" id="previewRefresh" title="Reload the preview from the server">↻ Refresh</button>
          </div>
        </div>
        <div class="preview-shell">
          <div class="preview-frame-wrap desktop" id="previewWrap">
            <iframe id="livePreview" src="/portfolio" title="Portfolio preview"></iframe>
          </div>
        </div>
      </div>

      <div class="card">
        <h2>Project pages &amp; More Projects</h2>
        <p class="hint">The project page layout and the “More Projects” carousel at the bottom of it.</p>
        <div class="field-grid">
          <div class="field">
            <label for="setProjectTitleSize">Project title size (rem)</label>
            <input type="number" id="setProjectTitleSize" min="1.6" max="3.2" step="0.1" data-draft="appearance" data-path="project.titleSize" data-kind="number">
          </div>
          <div class="field">
            <label for="setProjectDescWidth">Description width (px)</label>
            <input type="number" id="setProjectDescWidth" min="420" max="860" step="20" data-draft="appearance" data-path="project.descriptionWidth" data-kind="number">
          </div>
          <div class="field">
            <label for="setProjectDefaultWidth">New project page width</label>
            <select id="setProjectDefaultWidth" data-draft="appearance" data-path="project.defaultWidth" data-kind="number">
              <option value="640">Narrow (640px)</option>
              <option value="860">Medium (860px)</option>
              <option value="1100">Standard (1100px)</option>
              <option value="1400">Wide (1400px)</option>
            </select>
          </div>
          <div class="field">
            <label for="setProjectDefaultGap">New project image spacing</label>
            <select id="setProjectDefaultGap" data-draft="appearance" data-path="project.defaultGap" data-kind="number">
              <option value="0">None</option>
              <option value="1">Tight</option>
              <option value="2">Normal</option>
              <option value="4">Wide</option>
            </select>
          </div>
          <div class="field">
            <label for="setCarouselItemWidth">Carousel item width (px)</label>
            <input type="number" id="setCarouselItemWidth" min="200" max="360" step="10" data-draft="appearance" data-path="project.carouselItemWidth" data-kind="number">
          </div>
          <div class="field">
            <label for="setCarouselCoverRatio">Carousel cover shape</label>
            <select id="setCarouselCoverRatio" data-draft="appearance" data-path="project.carouselCoverRatio">
              <option value="4/3">4 : 3</option>
              <option value="3/2">3 : 2</option>
              <option value="16/9">16 : 9</option>
              <option value="1/1">Square (1 : 1)</option>
            </select>
          </div>
        </div>
        <label class="inline-check check-row"><input type="checkbox" id="setCarouselShow" data-draft="appearance" data-path="project.carouselShow" data-kind="bool"> Show the More Projects carousel on project pages</label>
      </div>

      <div class="card">
        <h2>Typography</h2>
        <p class="hint">Fonts and text sizes across the whole site.</p>
        <div class="field-grid">
          <div class="field">
            <label for="setTypeFont">Font</label>
            <select id="setTypeFont" data-draft="appearance" data-path="type.font">
              <option value="open-sans">Open Sans (current)</option>
              <option value="inter">Inter</option>
              <option value="source-sans">Source Sans 3</option>
              <option value="georgia">Georgia (serif)</option>
              <option value="system">System UI font</option>
            </select>
          </div>
          <div class="field">
            <label for="setTypeScale">Text scale</label>
            <input type="number" id="setTypeScale" min="0.9" max="1.15" step="0.01" data-draft="appearance" data-path="type.scale" data-kind="number">
          </div>
          <div class="field">
            <label for="setTypeHeadingWeight">Heading weight</label>
            <select id="setTypeHeadingWeight" data-draft="appearance" data-path="type.headingWeight" data-kind="number">
              <option value="500">Medium (500)</option>
              <option value="600">Semibold (600)</option>
              <option value="700">Bold (700)</option>
            </select>
          </div>
          <div class="field">
            <label for="setTypeNavSize">Nav link size (rem)</label>
            <input type="number" id="setTypeNavSize" min="0.7" max="1" step="0.01" data-draft="appearance" data-path="type.navSize" data-kind="number">
          </div>
          <div class="field">
            <label for="setTypeNavSpacing">Nav letter spacing (px)</label>
            <input type="number" id="setTypeNavSpacing" min="0" max="3" step="0.5" data-draft="appearance" data-path="type.navSpacing" data-kind="number">
          </div>
        </div>
        <label class="inline-check check-row"><input type="checkbox" id="setTypeNavUppercase" data-draft="appearance" data-path="type.navUppercase" data-kind="bool"> Uppercase navigation links</label>
      </div>

      <div class="card">
        <h2>Colors</h2>
        <p class="hint">Accent colors used across the site. Click a swatch to open the color picker.</p>
        <div class="field-grid">
          <div class="field">
            <label for="setColorNavActive">Nav active color</label>
            <input type="color" id="setColorNavActive" data-draft="appearance" data-path="colors.navActive">
            <p class="hint">The current page link in the header turns this color.</p>
          </div>
          <div class="field">
            <label for="setColorTitleHover">Project title hover color</label>
            <input type="color" id="setColorTitleHover" data-draft="appearance" data-path="colors.titleHover">
            <p class="hint">Project titles on the Portfolio grid turn this color on hover.</p>
          </div>
        </div>
        <div class="tint-grid">
          <div class="tint-row">
            <label class="inline-check"><input type="checkbox" id="tintLogo"> Tint the logo</label>
            <input type="color" id="setColorLogo" data-draft="appearance" data-path="colors.logo">
            <span class="hint" id="logoTintHint"></span>
          </div>
          <div class="tint-row">
            <label class="inline-check"><input type="checkbox" id="tintFavicon"> Tint the favicon</label>
            <input type="color" id="setColorFavicon" data-draft="appearance" data-path="colors.favicon">
            <span class="hint" id="faviconTintHint"></span>
          </div>
        </div>
      </div>

      <div class="card">
        <h2>Background Color</h2>
        <p class="hint">Used on every page of your site. Projects with their own background color keep theirs. Text and the logo switch between light and dark automatically so they stay readable. This card also saves on its own, and the main “Save changes” button picks up any change you make here.</p>
        <div class="bg-settings">
          <input type="color" id="siteBgPicker">
          <input type="text" id="siteBgHex" maxlength="7" spellcheck="false">
          <div class="bg-preview" id="siteBgPreview"><strong>Preview</strong><span>How text looks on this background</span></div>
        </div>
        <div style="display:flex; gap:0.5rem; margin-top:1rem;">
          <button type="button" class="btn" id="siteBgSave">Save Background</button>
          <button type="button" class="btn btn-outline" id="siteBgReset">Reset to Default</button>
        </div>
        <p class="status-msg" id="siteBgStatus"></p>
      </div>

      <div class="card">
        <h2>Contact page</h2>
        <p class="hint">The text on your Contact page. Messages still arrive in the Inbox tab.</p>
        <div class="field-grid">
          <div class="field">
            <label for="setContactHeading">Heading</label>
            <input type="text" id="setContactHeading" data-draft="content" data-path="contact.heading">
          </div>
          <div class="field">
            <label for="setContactEmail">Contact email</label>
            <input type="email" id="setContactEmail" placeholder="you@example.com" data-draft="content" data-path="contact.email">
          </div>
        </div>
        <div class="field">
          <label for="setContactIntro">Intro text</label>
          <textarea id="setContactIntro" rows="3" data-draft="content" data-path="contact.intro"></textarea>
        </div>
        <div class="field">
          <label for="setContactSuccess">Success message (after a message is sent)</label>
          <textarea id="setContactSuccess" rows="2" data-draft="content" data-path="contact.success"></textarea>
        </div>
      </div>

      <div class="card">
        <div class="card-head">
          <div>
            <h2>About page</h2>
            <p class="hint" style="margin:0;">The content of your About page, which is the site root (/).</p>
          </div>
          <a class="mini" href="/" target="_blank" rel="noopener">Preview about page ↗</a>
        </div>
        <div class="field-grid">
          <div class="field">
            <label for="setAboutEyebrow">Eyebrow</label>
            <input type="text" id="setAboutEyebrow" placeholder="About me" data-draft="content" data-path="about.eyebrow">
          </div>
          <div class="field">
            <label for="setAboutHeadline">Headline</label>
            <input type="text" id="setAboutHeadline" placeholder="I'm Jon Messier." data-draft="content" data-path="about.headline">
          </div>
          <div class="field">
            <label for="setAboutSubhead">Subhead</label>
            <input type="text" id="setAboutSubhead" placeholder="But I am also..." data-draft="content" data-path="about.subhead">
          </div>
        </div>
        <div class="field">
          <label for="setAboutRoles">Rotating roles (one per line, up to 6)</label>
          <textarea id="setAboutRoles" rows="4" placeholder="A visual storyteller.&#10;A restless learner.&#10;A curious generalist." data-draft="content" data-path="about.roles"></textarea>
          <p class="hint">Each line becomes a role that rotates on the page.</p>
        </div>
        <div class="field">
          <label for="setAboutIntro">Intro</label>
          <textarea id="setAboutIntro" rows="4" placeholder="A short intro about you. Leave empty to hide this section." data-draft="content" data-path="about.intro"></textarea>
        </div>
        <div class="field-grid">
          <div class="field">
            <label for="setAboutQuote">Quote</label>
            <textarea id="setAboutQuote" rows="3" placeholder="A large pull quote. Leave empty to hide it." data-draft="content" data-path="about.quote"></textarea>
          </div>
          <div class="field">
            <label for="setAboutQuoteText">Quote support text</label>
            <textarea id="setAboutQuoteText" rows="3" placeholder="A sentence supporting the quote." data-draft="content" data-path="about.quoteText"></textarea>
          </div>
        </div>
        <div class="field">
          <label>Headshot</label>
          <div class="upload-row">
            <div class="upload-thumb portrait" id="aboutHeadshotPreview"><span>None</span></div>
            <div>
              <button type="button" class="mini" id="aboutHeadshotUpload">Upload headshot…</button>
              <p class="hint" id="aboutHeadshotStatus">Uploaded as-is. Empty shows a monogram fallback on the page.</p>
            </div>
          </div>
        </div>
        <div class="field-grid">
          <div class="field">
            <label for="setAboutButtonText">Button text</label>
            <input type="text" id="setAboutButtonText" placeholder="Let's get in touch!" data-draft="content" data-path="about.buttonText">
          </div>
          <div class="field">
            <label for="setAboutButtonUrl">Button URL</label>
            <input type="text" id="setAboutButtonUrl" placeholder="/contact" data-draft="content" data-path="about.buttonUrl">
          </div>
        </div>
        <p class="hint">The button is hidden when its text or URL is empty. The URL must start with <code>/</code> or <code>http(s)://</code>.</p>
      </div>

      <div class="card">
        <h2>Footer &amp; social links</h2>
        <p class="hint">The footer at the bottom of every page.</p>
        <label class="inline-check check-row"><input type="checkbox" id="setFooterShow" data-draft="content" data-path="footer.show" data-kind="bool"> Show the footer on public pages</label>
        <div class="field" style="margin-bottom:1rem;">
          <label for="setFooterText">Copyright text</label>
          <input type="text" id="setFooterText" data-draft="content" data-path="footer.text" placeholder="Leave empty for “© current year + site name”">
          <p class="hint">Leave empty to show “© current year + site name”.</p>
        </div>
        <div class="social-head">
