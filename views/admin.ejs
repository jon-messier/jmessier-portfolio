      </div>

      <div class="save-bar" id="settingsSaveBar">
        <span class="save-note" id="settingsDirty">All settings saved</span>
        <div class="save-actions">
          <button type="button" class="btn btn-outline" id="settingsDiscard">Discard changes</button>
