<%
  // The login page only receives { error } (string, may be empty). The server has no
  // appearance/content data here, so styles stay inline and the brand is hardcoded.
  var loginError = (typeof error !== 'undefined' && error) ? String(error) : '';
  var brandName = (typeof siteName !== 'undefined' && siteName) ? String(siteName) : 'Jon Messier';
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin login | <%= brandName %></title>
  <style>
    :root { color-scheme: dark; }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem 1.25rem;
      background: radial-gradient(circle at 50% 0%, #242424 0%, #181818 45%, #101010 100%);
      color: #fff;
      font-family: 'Open Sans', 'Segoe UI', system-ui, -apple-system, sans-serif;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }
    .login-card {
      width: min(100%, 380px);
      background: #202020;
      border: 1px solid rgba(255, 255, 255, 0.09);
      border-radius: 14px;
      padding: 2.25rem 2rem 1.75rem;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
    }
    .brand { text-align: center; margin-bottom: 1.75rem; }
    .brand-mark {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 46px;
      height: 46px;
      margin-bottom: 0.9rem;
      border-radius: 50%;
      background: #2b2b2b;
      border: 1px solid rgba(255, 255, 255, 0.1);
      font-size: 0.95rem;
      font-weight: 700;
      letter-spacing: -1px;
      color: #fff;
    }
    .brand h1 { margin: 0; font-size: 1.35rem; font-weight: 600; letter-spacing: 0.5px; }
    .brand p { margin: 0.35rem 0 0; font-size: 0.72rem; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: #8a8a8a; }
    .field { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.1rem; }
    .field label { font-size: 0.7rem; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: #9a9a9a; }
    .field input {
      width: 100%;
      padding: 0.8rem 0.9rem;
      font: inherit;
      font-size: 0.95rem;
      color: #fff;
      background: #171717;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 8px;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .field input:focus {
      outline: none;
      border-color: #ffffff;
      box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.08);
    }
    .password-wrap { position: relative; }
    .password-wrap input { padding-right: 4.4rem; }
    .toggle {
      position: absolute;
      top: 50%;
      right: 0.4rem;
      transform: translateY(-50%);
      padding: 0.35rem 0.55rem;
      font: inherit;
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: #b5b5b5;
      background: transparent;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      transition: color 0.2s ease, background-color 0.2s ease;
    }
    .toggle:hover, .toggle:focus-visible { color: #fff; background: rgba(255, 255, 255, 0.08); outline: none; }
    .submit {
      width: 100%;
      margin-top: 0.4rem;
      padding: 0.85rem 1rem;
      font: inherit;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: #181818;
      background: #fff;
      border: none;
      border-radius: 30px;
      cursor: pointer;
      transition: opacity 0.2s ease, transform 0.15s ease;
    }
    .submit:hover { opacity: 0.88; }
    .submit:active { transform: scale(0.99); }
    .login-error {
      margin-bottom: 1.25rem;
      padding: 0.75rem 0.9rem;
      font-size: 0.88rem;
      line-height: 1.4;
      color: #ffb3b8;
      background: rgba(230, 57, 70, 0.14);
      border: 1px solid rgba(230, 57, 70, 0.5);
      border-radius: 8px;
    }
    .back-link {
      display: block;
      margin-top: 1.3rem;
      text-align: center;
      font-size: 0.8rem;
      color: #8a8a8a;
      text-decoration: none;
      transition: color 0.2s ease;
    }
    .back-link:hover, .back-link:focus-visible { color: #fff; outline: none; }
    @media (max-width: 420px) {
      .login-card { padding: 1.9rem 1.4rem 1.5rem; }
    }
  </style>
</head>
<body>
  <main class="login-card">
    <div class="brand">
      <span class="brand-mark" aria-hidden="true">JM</span>
      <h1><%= brandName %></h1>
      <p>Admin access</p>
    </div>

    <% if (loginError) { %>
      <div class="login-error" role="alert"><%= loginError %></div>
    <% } %>

    <form method="POST" action="/login">
      <div class="field">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" autocomplete="username" required autofocus>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <div class="password-wrap">
          <input type="password" id="password" name="password" autocomplete="current-password" required>
          <button type="button" id="toggle-password" class="toggle" aria-label="Show password" aria-pressed="false">Show</button>
        </div>
      </div>
      <button type="submit" class="submit">Log in</button>
    </form>
    <a class="back-link" href="/">← Back to site</a>
  </main>

  <script>
    // Show / hide the password without any external library.
    (function () {
      var input = document.getElementById('password');
      var toggle = document.getElementById('toggle-password');
      if (!input || !toggle) return;
      toggle.addEventListener('click', function () {
        var show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        toggle.textContent = show ? 'Hide' : 'Show';
        toggle.setAttribute('aria-pressed', show ? 'true' : 'false');
        toggle.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
        input.focus();
      });
    })();
  </script>
</body>
</html>
